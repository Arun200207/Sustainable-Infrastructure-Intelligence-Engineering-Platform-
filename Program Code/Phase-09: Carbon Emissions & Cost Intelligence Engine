)

for p in [CARBON_DIR, COST_DIR, REPORT_DIR]:
    p.mkdir(parents=True, exist_ok=True)

df = pd.read_parquet(MASTER_PATH)

required = [
    "date",
    "building_id",
    "building_name",
    "campus",
    "building_type",
    "electricity",
    "gas",
    "steam",
    "hotwater",
    "chilledwater",
    "solar",
    "sqm",
    "sqft",
    "occupants",
