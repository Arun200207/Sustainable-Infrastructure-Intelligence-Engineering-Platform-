phase09_building = carbon_building.merge(
    cost_building[
        [
            "building_id",
            "net_energy_cost_usd",
            "solar_savings_usd",
            "cost_intensity",
            "cost_score",
            "cost_rank"
        ]
    ],
    on="building_id",
    how="left"
)

# Combined Phase-09 score
phase09_building["carbon_cost_score"] = (
    0.60 * phase09_building["carbon_score"]
    + 0.40 * phase09_building["cost_score"]
)

# Performance category
phase09_building["carbon_cost_category"] = pd.cut(
    phase09_building["carbon_cost_score"],
    bins=[-np.inf, 40, 60, 80, np.inf],
    labels=[
        "Critical",
        "Needs Improvement",
        "Good",
        "Excellent"
    ]
)

phase09_building = phase09_building.sort_values(
    "carbon_cost_score",
    ascending=False
).reset_index(drop=True)

phase09_building["overall_rank"] = (
    np.arange(1, len(phase09_building) + 1)
