def get_nested_or_flat(data, keys, default=None):

    # Direct key
    for key in keys:
        if key in data:
            return data[key]

    # Recursive search
    def recurse(obj):

        if isinstance(obj, dict):

            for k, v in obj.items():

                normalized = (
                    str(k)
                    .lower()
                    .replace(" ", "_")
                    .replace("-", "_")
                )

                if normalized in keys:
                    return v

                found = recurse(v)

                if found is not None:
                    return found

        elif isinstance(obj, list):

            for item in obj:
                found = recurse(item)

                if found is not None:
                    return found

        return None

    return recurse(data) if data else default


