from pathlib import Path
import pandas as pd
import numpy as np
import json
import matplotlib.pyplot as plt
import seaborn as sns

PROJECT_ROOT = Path("/content/drive/MyDrive/GitHub_Project_01")

MASTER_PATH = (
    PROJECT_ROOT
    / "processed"
    / "sustainability"
    / "sustainability_master_dataset.parquet"
)

CARBON_DIR = (
    PROJECT_ROOT
    / "processed"
