print("\n✓ Phase-08 dataset successfully loaded.")
print("✓ Original dataset preserved.")

# ============================================================
# PHASE-09 | CELL 02
# CARBON + COST CONFIGURATION
# ============================================================

FACTORS = {

    # kg CO2e per kWh
    "carbon_kgco2e_per_kwh": {

        "electricity": 0.394,

        # Baseline research assumptions.
        # Replace with verified local/historical factors
        # if available.
        "gas": 0.181,
        "steam": 0.181,
        "hotwater": 0.181,
        "chilledwater": 0.394
    },

    # USD per kWh
    "cost_usd_per_kwh": {

        "electricity": 0.12,
        "gas": 0.05,
        "steam": 0.08,
        "hotwater": 0.08,
        "chilledwater": 0.12
    },

    # Solar is treated as avoided grid energy/carbon,
    # not as an additional consumption source.
    "solar_carbon_credit": True
}

print("=" * 70)
print("PHASE-09 FACTOR CONFIGURATION")
print("=" * 70)

print("\nCarbon factors:")
for k, v in FACTORS["carbon_kgco2e_per_kwh"].items():
    print(f"  {k:15} {v:.4f} kgCO2e/kWh")

print("\nCost factors:")
for k, v in FACTORS["cost_usd_per_kwh"].items():
    print(f"  {k:15} ${v:.4f}/kWh")

factor_path = CARBON_DIR / "phase09_factor_configuration.json"

with open(factor_path, "w") as f:
    json.dump(FACTORS, f, indent=4)

print("\n✓ Factor configuration saved.")

# ============================================================
# PHASE-09 | CELL 03
# CARBON EMISSIONS INTELLIGENCE
# ============================================================

carbon = df[
    [
        "date",
        "building_id",
        "building_name",
        "campus",
        "building_type",
        "electricity",
        "gas",
        "steam",
        "hotwater",
        "chilledwater",
        "solar",
        "sqm",
        "sqft",
        "occupants",
        "energy_risk_score"
    ]
].copy()

carbon["total_energy_kwh"] = (
    carbon["electricity"]
    + carbon["gas"]
    + carbon["steam"]
    + carbon["hotwater"]
    + carbon["chilledwater"]
)

# Individual carbon components
for source in FACTORS["carbon_kgco2e_per_kwh"]:

    carbon[f"{source}_carbon_kgco2e"] = (
        carbon[source]
        * FACTORS["carbon_kgco2e_per_kwh"][source]
    )

# Gross operational carbon
carbon["gross_carbon_kgco2e"] = (
    carbon["electricity_carbon_kgco2e"]
    + carbon["gas_carbon_kgco2e"]
    + carbon["steam_carbon_kgco2e"]
    + carbon["hotwater_carbon_kgco2e"]
    + carbon["chilledwater_carbon_kgco2e"]
)

# Solar carbon avoidance
carbon["solar_carbon_avoided_kgco2e"] = (
    carbon["solar"]
    * FACTORS["carbon_kgco2e_per_kwh"]["electricity"]
)

# Net carbon
carbon["net_carbon_kgco2e"] = (
    carbon["gross_carbon_kgco2e"]
    - carbon["solar_carbon_avoided_kgco2e"]
).clip(lower=0)

carbon["net_carbon_tco2e"] = (
    carbon["net_carbon_kgco2e"] / 1000
)

# Carbon intensity
carbon["carbon_intensity_kgco2e_per_sqm"] = np.where(
    carbon["sqm"] > 0,
    carbon["net_carbon_kgco2e"] / carbon["sqm"],
    np.nan
)

carbon["carbon_intensity_kgco2e_per_sqft"] = np.where(
    carbon["sqft"] > 0,
    carbon["net_carbon_kgco2e"] / carbon["sqft"],
    np.nan
)

carbon_path = CARBON_DIR / "carbon_intelligence.parquet"
carbon.to_parquet(carbon_path, index=False)

print("=" * 70)
print("CARBON INTELLIGENCE COMPLETE")
print("=" * 70)

print(f"Total Energy        : {carbon['total_energy_kwh'].sum():,.2f} kWh")
print(f"Gross Carbon        : {carbon['gross_carbon_kgco2e'].sum():,.2f} kgCO2e")
print(f"Solar Avoided       : {carbon['solar_carbon_avoided_kgco2e'].sum():,.2f} kgCO2e")
print(f"Net Carbon          : {carbon['net_carbon_tco2e'].sum():,.2f} tCO2e")

print("\n✓ Saved:", carbon_path)

# ============================================================
# PHASE-09 | CELL 04
# BUILDING CARBON KPI + RANKING
# ============================================================

carbon_building = (
    carbon
    .groupby(
        [
            "building_id",
            "building_name",
            "campus",
            "building_type"
        ],
        as_index=False
    )
    .agg(
        total_energy_kwh=("total_energy_kwh", "sum"),
        electricity_kwh=("electricity", "sum"),
        solar_kwh=("solar", "sum"),
        gross_carbon_kgco2e=("gross_carbon_kgco2e", "sum"),
        solar_carbon_avoided_kgco2e=(
            "solar_carbon_avoided_kgco2e",
            "sum"
        ),
        net_carbon_kgco2e=("net_carbon_kgco2e", "sum"),
        area_sqm=("sqm", "max"),
        area_sqft=("sqft", "max"),
        occupants=("occupants", "max"),
        avg_energy_risk=("energy_risk_score", "mean")
    )
)

carbon_building["net_carbon_tco2e"] = (
    carbon_building["net_carbon_kgco2e"] / 1000
)

carbon_building["carbon_intensity"] = np.where(
    carbon_building["area_sqm"] > 0,
    carbon_building["net_carbon_kgco2e"]
    / carbon_building["area_sqm"],
    np.nan
)

# Rank: lower carbon intensity = better
carbon_building["carbon_rank"] = (
    carbon_building["carbon_intensity"]
    .rank(method="min", ascending=True)
)

# Percentile
carbon_building["carbon_percentile"] = (
    carbon_building["carbon_intensity"]
    .rank(pct=True, ascending=False)
    * 100
)

# Carbon performance score: 0–100
carbon_building["carbon_score"] = (
    100
    * (
        1
        - (
            carbon_building["carbon_intensity"]
            - carbon_building["carbon_intensity"].min()
        )
        / (
            carbon_building["carbon_intensity"].max()
            - carbon_building["carbon_intensity"].min()
            + 1e-9
        )
    )
).clip(0, 100)

carbon_building = carbon_building.sort_values(
    "carbon_score",
    ascending=False
)

carbon_building_path = (
    CARBON_DIR / "carbon_building_ranking.parquet"
)

carbon_building.to_parquet(
    carbon_building_path,
    index=False
)

print("=" * 70)
print("BUILDING CARBON RANKING COMPLETE")
print("=" * 70)

display(
