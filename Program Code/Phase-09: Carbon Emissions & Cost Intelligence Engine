# Cost by energy source
for source in FACTORS["cost_usd_per_kwh"]:

    cost[f"{source}_cost_usd"] = (
        cost[source]
        * FACTORS["cost_usd_per_kwh"][source]
    )

# Gross cost
cost["gross_energy_cost_usd"] = (
    cost["electricity_cost_usd"]
    + cost["gas_cost_usd"]
    + cost["steam_cost_usd"]
    + cost["hotwater_cost_usd"]
    + cost["chilledwater_cost_usd"]
)

# Solar savings / avoided electricity cost
cost["solar_savings_usd"] = (
    cost["solar"]
    * FACTORS["cost_usd_per_kwh"]["electricity"]
)

# Net estimated energy cost
cost["net_energy_cost_usd"] = (
    cost["gross_energy_cost_usd"]
    - cost["solar_savings_usd"]
).clip(lower=0)

# Cost intensity
cost["cost_intensity_usd_per_sqm"] = np.where(
    cost["sqm"] > 0,
    cost["net_energy_cost_usd"] / cost["sqm"],
    np.nan
)

cost_path = COST_DIR / "energy_cost_intelligence.parquet"

cost.to_parquet(
