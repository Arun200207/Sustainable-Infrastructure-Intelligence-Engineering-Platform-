    .agg(
        gross_energy_cost_usd=(
            "gross_energy_cost_usd",
            "sum"
        ),
        solar_savings_usd=(
            "solar_savings_usd",
            "sum"
        ),
        net_energy_cost_usd=(
            "net_energy_cost_usd",
            "sum"
        ),
        area_sqm=("sqm", "max"),
        area_sqft=("sqft", "max"),
        occupants=("occupants", "max"),
        avg_energy_risk=("energy_risk_score", "mean")
    )
)

cost_building["cost_intensity"] = np.where(
    cost_building["area_sqm"] > 0,
    cost_building["net_energy_cost_usd"]
    / cost_building["area_sqm"],
    np.nan
)

# Lower cost intensity = better
cost_building["cost_rank"] = (
    cost_building["cost_intensity"]
    .rank(method="min", ascending=True)
)

cost_building["cost_score"] = (
    100
    * (
        1
        - (
            cost_building["cost_intensity"]
            - cost_building["cost_intensity"].min()
        )
        / (
            cost_building["cost_intensity"].max()
            - cost_building["cost_intensity"].min()
            + 1e-9
        )
    )
).clip(0, 100)

cost_building = cost_building.sort_values(
    "cost_score",
    ascending=False
)

cost_building_path = (
    COST_DIR / "cost_building_ranking.parquet"
)

cost_building.to_parquet(
    cost_building_path,
    index=False
)

print("=" * 70)
print("BUILDING COST RANKING COMPLETE")
print("=" * 70)

display(
