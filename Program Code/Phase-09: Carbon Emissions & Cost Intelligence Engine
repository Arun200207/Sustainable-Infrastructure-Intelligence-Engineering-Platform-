# =============================================================================
# COMPLETE PHASE-09: CARBON & COST INTELLIGENCE PIPELINE
# Sustainable Infrastructure Intelligence Platform
#
# PURPOSE:
#   Compute end-to-end carbon emissions, energy costs, solar avoidance, 
#   building-level rankings, multi-factor scores, and authoritative KPIs
#   directly from the Phase-08 master dataset.
# =============================================================================

from pathlib import Path
from datetime import datetime
import pandas as pd
import numpy as np
import json
import shutil

# =============================================================================
# 01. CONFIGURATION & DIRECTORY SETUP
# =============================================================================

PROJECT_ROOT = Path("/content/gdrive/MyDrive/GitHub_Project_01")

if not PROJECT_ROOT.exists():
    raise FileNotFoundError(f"Project root not found: {PROJECT_ROOT}")

SUSTAINABILITY_DIR = PROJECT_ROOT / "processed" / "sustainability"
CARBON_DIR = SUSTAINABILITY_DIR / "carbon"
COST_DIR = SUSTAINABILITY_DIR / "cost"
REPORT_DIR = PROJECT_ROOT / "reports" / "sustainability"

CARBON_DIR.mkdir(parents=True, exist_ok=True)
COST_DIR.mkdir(parents=True, exist_ok=True)
REPORT_DIR.mkdir(parents=True, exist_ok=True)

PHASE08_PATH = SUSTAINABILITY_DIR / "sustainability_master_dataset.parquet"

CARBON_PATH = CARBON_DIR / "carbon_intelligence.parquet"
CARBON_BUILDING_PATH = CARBON_DIR / "carbon_building_ranking.parquet"

COST_PATH = COST_DIR / "energy_cost_intelligence.parquet"
COST_BUILDING_PATH = COST_DIR / "cost_building_ranking.parquet"

PHASE09_MASTER_PATH = SUSTAINABILITY_DIR / "carbon_cost_master.parquet"
PHASE09_BUILDING_PATH = SUSTAINABILITY_DIR / "carbon_cost_building_intelligence.parquet"

FACTOR_PATH = CARBON_DIR / "phase09_factor_configuration.json"

print("=" * 110)
print("COMPLETE PHASE-09: CARBON & COST INTELLIGENCE PIPELINE")
print("Sustainable Infrastructure Intelligence Platform")
print("=" * 110)

# =============================================================================
# 02. FACTOR CONFIGURATION DEFINITION
# =============================================================================

# Standardized conversion factors for carbon (kg CO2e per kWh) and cost (USD per kWh)
factors = {
    "carbon_kgco2e_per_kwh": {
        "electricity": 0.415,
        "gas": 0.185,
        "steam": 0.230,
        "hotwater": 0.200,
        "chilledwater": 0.150
    },
    "cost_usd_per_kwh": {
        "electricity": 0.120,
        "gas": 0.045,
        "steam": 0.085,
        "hotwater": 0.070,
        "chilledwater": 0.060
    }
}

with open(FACTOR_PATH, "w") as f:
    json.dump(factors, f, indent=2)

carbon_factors = factors["carbon_kgco2e_per_kwh"]
cost_factors = factors["cost_usd_per_kwh"]

print("\n[01] FACTOR CONFIGURATION INITIALIZED")
print("-" * 110)
for k, v in carbon_factors.items():
    print(f"Carbon  {k:<15}: {v} kg CO2e / kWh")
for k, v in cost_factors.items():
    print(f"Cost    {k:<15}: ${v} / kWh")

# =============================================================================
# 03. ARTIFACT CHECK & LOAD PHASE-08
# =============================================================================

print("\n[02] LOADING PHASE-08 MASTER DATASET")
print("-" * 110)

if not PHASE08_PATH.exists():
    raise FileNotFoundError(f"Phase-08 master dataset not found at: {PHASE08_PATH}")

phase08 = pd.read_parquet(PHASE08_PATH)
print(f"✓ Loaded Phase-08 Master Dataset: {len(phase08):,} rows, {phase08['building_id'].nunique()} buildings.")

# =============================================================================
# 04. CARBON INTELLIGENCE ENGINE
# =============================================================================

print("\n[03] COMPUTING CARBON INTELLIGENCE")
print("-" * 110)

energy_cols = ["electricity", "gas", "steam", "hotwater", "chilledwater"]
solar_col = "solar"

carbon = phase08.copy()

for source in energy_cols:
    output_col = f"{source}_carbon_kgco2e"
    carbon[output_col] = (
        pd.to_numeric(carbon[source], errors="coerce").fillna(0)
        * float(carbon_factors[source])
    )

carbon["total_energy_kwh"] = (
    carbon[energy_cols]
    .apply(pd.to_numeric, errors="coerce")
    .fillna(0)
    .sum(axis=1)
)

carbon["gross_carbon_kgco2e"] = (
    carbon[[f"{s}_carbon_kgco2e" for s in energy_cols]]
    .sum(axis=1)
)

carbon["solar_carbon_avoided_kgco2e"] = (
    pd.to_numeric(carbon[solar_col], errors="coerce").fillna(0)
    * float(carbon_factors["electricity"])
)

carbon["net_carbon_kgco2e"] = (
    carbon["gross_carbon_kgco2e"] - carbon["solar_carbon_avoided_kgco2e"]
)

carbon["net_carbon_tco2e"] = carbon["net_carbon_kgco2e"] / 1000.0

carbon["carbon_intensity_kgco2e_per_sqm"] = (
    carbon["net_carbon_kgco2e"] / carbon["sqm"].replace(0, np.nan)
)

carbon["carbon_intensity_kgco2e_per_sqft"] = (
    carbon["net_carbon_kgco2e"] / carbon["sqft"].replace(0, np.nan)
)

print("✓ Carbon intelligence calculations complete.")

# =============================================================================
# 05. COST INTELLIGENCE ENGINE
# =============================================================================

print("\n[04] COMPUTING ENERGY COST INTELLIGENCE")
print("-" * 110)

cost = phase08.copy()

for source in energy_cols:
    output_col = f"{source}_cost_usd"
    cost[output_col] = (
        pd.to_numeric(cost[source], errors="coerce").fillna(0)
        * float(cost_factors[source])
    )

cost["gross_energy_cost_usd"] = (
    cost[[f"{s}_cost_usd" for s in energy_cols]]
    .sum(axis=1)
)

cost["solar_savings_usd"] = (
    pd.to_numeric(cost[solar_col], errors="coerce").fillna(0)
    * float(cost_factors["electricity"])
)

cost["net_energy_cost_usd"] = (
    cost["gross_energy_cost_usd"] - cost["solar_savings_usd"]
)

cost["cost_intensity_usd_per_sqm"] = (
    cost["net_energy_cost_usd"] / cost["sqm"].replace(0, np.nan)
)

print("✓ Cost intelligence calculations complete.")

# =============================================================================
# 06. BUILDING-LEVEL CARBON AGGREGATION & SCORING
# =============================================================================

print("\n[05] COMPUTING BUILDING-LEVEL CARBON INTELLIGENCE")
print("-" * 110)

group_cols = ["building_id", "building_name", "campus", "building_type"]

carbon_building = (
    carbon.groupby(group_cols, dropna=False)
    .agg(
        total_energy_kwh=("total_energy_kwh", "sum"),
        electricity_kwh=("electricity", "sum"),
        solar_kwh=("solar", "sum"),
        gross_carbon_kgco2e=("gross_carbon_kgco2e", "sum"),
        solar_carbon_avoided_kgco2e=("solar_carbon_avoided_kgco2e", "sum"),
        net_carbon_kgco2e=("net_carbon_kgco2e", "sum"),
        area_sqm=("sqm", "mean"),
        area_sqft=("sqft", "mean"),
        occupants=("occupants", "mean"),
        avg_energy_risk=("energy_risk_score", "mean"),
    )
    .reset_index()
)

carbon_building["net_carbon_tco2e"] = carbon_building["net_carbon_kgco2e"] / 1000.0

carbon_building["carbon_intensity"] = (
    carbon_building["net_carbon_kgco2e"] / carbon_building["area_sqm"].replace(0, np.nan)
)

carbon_building["carbon_rank"] = (
    carbon_building["carbon_intensity"].rank(method="min", ascending=True).astype(int)
)

carbon_building["carbon_percentile"] = (
    carbon_building["carbon_intensity"].rank(pct=True, ascending=False)
)

ci = carbon_building["carbon_intensity"]
ci_min, ci_max = ci.min(), ci.max()

if ci_max > ci_min:
    carbon_building["carbon_score"] = 100 * (ci_max - ci) / (ci_max - ci_min)
else:
    carbon_building["carbon_score"] = 100.0

carbon_building["carbon_score"] = carbon_building["carbon_score"].clip(0, 100)

print("✓ Building carbon rankings and scores generated.")

# =============================================================================
# 07. BUILDING-LEVEL COST AGGREGATION & SCORING
# =============================================================================

print("\n[06] COMPUTING BUILDING-LEVEL COST INTELLIGENCE")
print("-" * 110)

cost_building = (
    cost.groupby(group_cols, dropna=False)
    .agg(
        net_energy_cost_usd=("net_energy_cost_usd", "sum"),
        solar_savings_usd=("solar_savings_usd", "sum"),
        area_sqm=("sqm", "mean"),
        area_sqft=("sqft", "mean"),
        occupants=("occupants", "mean"),
        avg_energy_risk=("energy_risk_score", "mean"),
    )
    .reset_index()
)

cost_building["cost_intensity"] = (
    cost_building["net_energy_cost_usd"] / cost_building["area_sqm"].replace(0, np.nan)
)

cost_building["cost_rank"] = (
    cost_building["cost_intensity"].rank(method="min", ascending=True).astype(int)
)

ci2 = cost_building["cost_intensity"]
ci2_min, ci2_max = ci2.min(), ci2.max()

if ci2_max > ci2_min:
    cost_building["cost_score"] = 100 * (ci2_max - ci2) / (ci2_max - ci2_min)
else:
    cost_building["cost_score"] = 100.0

cost_building["cost_score"] = cost_building["cost_score"].clip(0, 100)

print("✓ Building cost rankings and scores generated.")

# =============================================================================
# 08. COMBINED BUILDING INTELLIGENCE & SCORING
# =============================================================================

print("\n[07] MERGING COMBINED BUILDING INTELLIGENCE")
print("-" * 110)

building = carbon_building.merge(
    cost_building[["building_id", "net_energy_cost_usd", "solar_savings_usd", "cost_intensity", "cost_score", "cost_rank"]],
    on="building_id",
    how="left",
    validate="one_to_one"
)

# 60% Carbon, 40% Cost weighted score
building["carbon_cost_score"] = (
    0.60 * building["carbon_score"] + 0.40 * building["cost_score"]
)

def classify_score(x):
    if x < 25:
        return "Critical"
    elif x < 50:
        return "Needs Improvement"
    elif x < 75:
        return "Good"
    else:
        return "Excellent"

building["carbon_cost_category"] = building["carbon_cost_score"].apply(classify_score)

building["overall_rank"] = (
    building["carbon_cost_score"].rank(method="first", ascending=False).astype(int)
)

print("✓ Combined building intelligence synthesized.")

# =============================================================================
# 09. COMPILING PHASE-09 MASTER DATASET
# =============================================================================

print("\n[08] COMPILING PHASE-09 MASTER DATASET")
print("-" * 110)

score_map = building[
    ["building_id", "carbon_score", "cost_score", "carbon_cost_score", "carbon_cost_category", "overall_rank"]
].copy()

phase09_master = (
    carbon[[
        "date", "building_id", "building_name", "campus", "building_type",
        "electricity", "gas", "steam", "hotwater", "chilledwater", "solar",
        "sqm", "sqft", "occupants", "energy_risk_score", "total_energy_kwh",
        "electricity_carbon_kgco2e", "gas_carbon_kgco2e", "steam_carbon_kgco2e",
        "hotwater_carbon_kgco2e", "chilledwater_carbon_kgco2e", "gross_carbon_kgco2e",
        "solar_carbon_avoided_kgco2e", "net_carbon_kgco2e", "net_carbon_tco2e",
        "carbon_intensity_kgco2e_per_sqm", "carbon_intensity_kgco2e_per_sqft"
    ]]
    .merge(
        cost[["building_id", "date", "gross_energy_cost_usd", "solar_savings_usd", "net_energy_cost_usd", "cost_intensity_usd_per_sqm"]],
        on=["building_id", "date"],
        how="left",
        validate="one_to_one"
    )
    .merge(
        score_map,
        on="building_id",
        how="left",
        validate="many_to_one"
    )
)

phase09_building = building[[
    "building_id", "building_name", "campus", "building_type", "total_energy_kwh",
    "electricity_kwh", "solar_kwh", "gross_carbon_kgco2e", "solar_carbon_avoided_kgco2e",
    "net_carbon_kgco2e", "area_sqm", "area_sqft", "occupants", "avg_energy_risk",
    "net_carbon_tco2e", "carbon_intensity", "carbon_rank", "carbon_percentile",
    "carbon_score", "net_energy_cost_usd", "solar_savings_usd", "cost_intensity",
    "cost_score", "cost_rank", "carbon_cost_score", "carbon_cost_category", "overall_rank"
]].copy()

print(f"✓ Phase-09 Master compiled: {len(phase09_master):,} rows.")

# =============================================================================
# 10. PERSISTENCE & ARTIFACT EXPORT
# =============================================================================

print("\n[09] SAVING PHASE-09 ARTIFACTS")
print("-" * 110)

carbon.to_parquet(CARBON_PATH, index=False)
carbon_building.to_parquet(CARBON_BUILDING_PATH, index=False)
cost.to_parquet(COST_PATH, index=False)
cost_building.to_parquet(COST_BUILDING_PATH, index=False)
phase09_master.to_parquet(PHASE09_MASTER_PATH, index=False)
phase09_building.to_parquet(PHASE09_BUILDING_PATH, index=False)

print("✓ Carbon intelligence saved.")
print("✓ Carbon building ranking saved.")
print("✓ Cost intelligence saved.")
print("✓ Cost building ranking saved.")
print("✓ Phase-09 master dataset saved.")
print("✓ Phase-09 building intelligence saved.")

# =============================================================================
# 11. COMPREHENSIVE NUMERICAL AUDIT & VALIDATION
# =============================================================================

print("\n" + "=" * 110)
print("COMPREHENSIVE NUMERICAL AUDIT")
print("=" * 110)

energy_expected = phase08[energy_cols].apply(pd.to_numeric, errors="coerce").fillna(0).sum().sum()
energy_actual = phase09_master["total_energy_kwh"].sum()
energy_diff = energy_actual - energy_expected

gross_expected = sum(phase08[s].sum() * carbon_factors[s] for s in energy_cols)
solar_carbon_expected = phase08["solar"].sum() * carbon_factors["electricity"]
net_carbon_expected_t = (gross_expected - solar_carbon_expected) / 1000.0

gross_actual = carbon["gross_carbon_kgco2e"].sum()
solar_carbon_actual = carbon["solar_carbon_avoided_kgco2e"].sum()
net_carbon_actual_t = carbon["net_carbon_kgco2e"].sum() / 1000.0

gross_cost_expected = sum(phase08[s].sum() * cost_factors[s] for s in energy_cols)
solar_savings_expected = phase08["solar"].sum() * cost_factors["electricity"]
net_cost_expected = gross_cost_expected - solar_savings_expected

gross_cost_actual = cost["gross_energy_cost_usd"].sum()
solar_savings_actual = cost["solar_savings_usd"].sum()
net_cost_actual = cost["net_energy_cost_usd"].sum()

formula_expected = 0.60 * building["carbon_score"] + 0.40 * building["cost_score"]
formula_error = (building["carbon_cost_score"] - formula_expected).abs()

checks = {
    "row_preservation": len(phase08) == len(phase09_master),
    "building_preservation": phase08["building_id"].nunique() == phase09_master["building_id"].nunique(),
    "energy_formula": abs(energy_diff) <= 1e-6,
    "gross_carbon": abs(gross_actual - gross_expected) <= 1e-3,
    "solar_carbon": abs(solar_carbon_actual - solar_carbon_expected) <= 1e-3,
    "net_carbon": abs(net_carbon_actual_t - net_carbon_expected_t) <= 1e-6,
    "gross_cost": abs(gross_cost_actual - gross_cost_expected) <= 0.01,
    "solar_savings": abs(solar_savings_actual - solar_savings_expected) <= 0.01,
    "net_cost": abs(net_cost_actual - net_cost_expected) <= 0.01,
    "score_formula": formula_error.max() <= 1e-10,
    "score_range": building["carbon_score"].between(0, 100).all() and building["cost_score"].between(0, 100).all(),
    "overall_rank_integrity": building["overall_rank"].min() == 1 and building["overall_rank"].max() == len(building)
}

print("\nVALIDATION RESULTS:")
for name, result in checks.items():
    print(f"{'✓ PASS' if result else '✗ FAIL':<10} | {name}")

all_pass = all(checks.values())

# =============================================================================
# 12. PHASE-10 KPI REPORT GENERATION
# =============================================================================

KPI_PATH = REPORT_DIR / "phase09_carbon_cost_kpis.json"

kpis = {
    "total_buildings": int(phase09_building["building_id"].nunique()),
    "total_daily_records": int(len(phase09_master)),
    "total_energy_kwh": float(energy_actual),
    "gross_carbon_tco2e": float(gross_actual / 1000.0),
    "solar_carbon_avoided_tco2e": float(solar_carbon_actual / 1000.0),
    "net_carbon_tco2e": float(net_carbon_actual_t),
    "gross_energy_cost_usd": float(gross_cost_actual),
    "solar_savings_usd": float(solar_savings_actual),
    "net_energy_cost_usd": float(net_cost_actual),
    "average_carbon_score": float(phase09_building["carbon_score"].mean()),
    "average_cost_score": float(phase09_building["cost_score"].mean()),
    "average_carbon_cost_score": float(phase09_building["carbon_cost_score"].mean()),
    "validation_status": "PASSED" if all_pass else "FAILED",
    "timestamp": datetime.now().isoformat()
}

with open(KPI_PATH, "w") as f:
    json.dump(kpis, f, indent=2)

print(f"\n✓ Phase-10 KPI report saved successfully at:\n{KPI_PATH}")
print("=" * 110)
