def warn(message):
    warnings_list.append(message)

def status_symbol(status):
    return "✓ PASS" if status == "PASS" else "⚠ WARNING" if status == "WARNING" else "✗ FAIL"

def print_result(label, status, details=None):
    print(f"{status_symbol(status):10s} | {label}")
