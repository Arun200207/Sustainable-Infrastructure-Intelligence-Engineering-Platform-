import gc
import os
import numpy as np
import pandas as pd

# Constants and Configuration (Ensure PROCESSED_PATH and DATA_PATH are defined)
FEATURE_PATH = os.path.join(PROCESSED_PATH, "feature_store")
os.makedirs(FEATURE_PATH, exist_ok=True)

# 1. Load and Prepare Base Electricity Data
electricity_daily_path = os.path.join(PROCESSED_PATH, "electricity_daily.parquet")
electricity_daily = pd.read_parquet(electricity_daily_path)

# Parse building ID components if not already done
parts = electricity_daily["building_id"].astype(str).str.split("_", n=2, expand=True)
electricity_daily["campus"] = parts[0]
electricity_daily["building_type"] = parts[1]
electricity_daily["building_name"] = parts[2]

# Temporal features
electricity_daily["date"] = pd.to_datetime(electricity_daily["date"])
electricity_daily["year"] = electricity_daily.date.dt.year
electricity_daily["month"] = electricity_daily.date.dt.month
electricity_daily["day"] = electricity_daily.date.dt.day
electricity_daily["weekday"] = electricity_daily.date.dt.weekday
electricity_daily["is_weekend"] = (electricity_daily.weekday >= 5).astype(int)

def get_season(month):
    if month in [12, 1, 2]:
        return "Winter"
    elif month in [3, 4, 5]:
        return "Spring"
    elif month in [6, 7, 8]:
        return "Summer"
    else:
        return "Autumn"

electricity_daily["season"] = electricity_daily.month.apply(get_season)

# Sort for sequential operations
electricity_daily = electricity_daily.sort_values(["building_id", "date"])

# Lags and Rolling Window Features
electricity_daily["lag_1"] = electricity_daily.groupby("building_id")["electricity"].shift(1)
electricity_daily["lag_7"] = electricity_daily.groupby("building_id")["electricity"].shift(7)

electricity_daily["rolling_7"] = (
    electricity_daily.groupby("building_id")["electricity"]
    .shift(1)
    .rolling(7)
    .mean()
    .reset_index(level=0, drop=True)
)

electricity_daily["rolling_30"] = (
    electricity_daily.groupby("building_id")["electricity"]
    .shift(1)
    .rolling(30)
    .mean()
    .reset_index(level=0, drop=True)
)

# 2. Process and Merge Additional Utilities
utilities = [
    "chilledwater",
    "hotwater",
    "gas",
    "steam",
    "water",
    "irrigation",
    "solar"
]

utility_daily = {}
for resource in utilities:
    print(f"Processing Utility: {resource}")
    path = os.path.join(PROCESSED_PATH, f"{resource}.parquet")
    
    if os.path.exists(path):
        df = pd.read_parquet(path)
        df["timestamp"] = pd.to_datetime(df["timestamp"])
        df["date"] = df["timestamp"].dt.floor("D")
        
        daily = (
            df.groupby(["date", "building_id"], as_index=False)[resource]
            .mean()
        )
        utility_daily[resource] = daily

feature_store = electricity_daily.copy()
print("Initial Shape with Electricity:", feature_store.shape)

for resource in utilities:
    if resource in utility_daily:
        feature_store = feature_store.merge(
            utility_daily[resource],
            on=["date", "building_id"],
            how="left"
        )

energy_cols = [c for c in utilities if c in feature_store.columns]
feature_store[energy_cols] = feature_store[energy_cols].fillna(0)

# 3. Merge Metadata
metadata_path = os.path.join(DATA_PATH, "metadata.csv")
if os.path.exists(metadata_path):
    metadata = pd.read_csv(metadata_path)
    metadata_columns = [
        "building_id", "site_id", "primaryspaceusage", "sub_primaryspaceusage",
        "sqm", "sqft", "lat", "lng", "timezone", "industry", "subindustry",
        "heatingtype", "yearbuilt", "date_opened", "numberoffloors",
        "occupants", "energystarscore", "eui", "site_eui", "source_eui",
        "leed_level", "rating"
    ]
    metadata_columns = [c for c in metadata_columns if c in metadata.columns]
    metadata = metadata[metadata_columns].drop_duplicates(subset=["building_id"])
    
    feature_store = feature_store.merge(metadata, on="building_id", how="left")

# 4. Merge and Engineer Weather Features
weather_path = os.path.join(DATA_PATH, "weather.csv")
if os.path.exists(weather_path):
    weather = pd.read_csv(weather_path)
    weather["timestamp"] = pd.to_datetime(weather["timestamp"])
    weather["date"] = weather["timestamp"].dt.floor("D")

    weather_daily = (
        weather.groupby(["date", "site_id"], as_index=False)
        .agg({
            "airTemperature": "mean",
            "cloudCoverage": "mean",
            "dewTemperature": "mean",
            "precipDepth1HR": "sum",
            "precipDepth6HR": "sum",
            "seaLvlPressure": "mean",
            "windDirection": "mean",
            "windSpeed": "mean"
        })
    )

    feature_store = feature_store.merge(weather_daily, on=["date", "site_id"], how="left")

# Advanced Weather Derivations
feature_store["temperature_diff"] = feature_store["airTemperature"] - feature_store["dewTemperature"]
feature_store["is_rain"] = (feature_store["precipDepth1HR"] > 0).astype(int)
feature_store["high_wind"] = (feature_store["windSpeed"] > 15).astype(int)
feature_store["heating_degree_days"] = (18 - feature_store["airTemperature"]).clip(lower=0)
feature_store["cooling_degree_days"] = (feature_store["airTemperature"] - 18).clip(lower=0)

# 5. Final Imputation and Cleanup
numeric_cols = feature_store.select_dtypes(include="number").columns
feature_store[numeric_cols] = feature_store[numeric_cols].fillna(0)

categorical_cols = feature_store.select_dtypes(include="object").columns
feature_store[categorical_cols] = feature_store[categorical_cols].fillna("Unknown")

feature_store = feature_store.drop_duplicates()
print("Final Feature Store Shape:", feature_store.shape)

# Memory Footprint
memory_mb = round(feature_store.memory_usage(deep=True).sum() / 1024**2, 2)
print(f"Memory Footprint: {memory_mb} MB")

# 6. Save Feature Store
output_file = os.path.join(FEATURE_PATH, "sustainable_feature_store.parquet")
feature_store.to_parquet(output_file, compression="snappy", index=False)
print("✅ Feature Store Saved Successfully:", output_file)
