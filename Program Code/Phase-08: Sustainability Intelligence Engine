# ================================================================
# 2. NORMALIZATION FUNCTION
# ================================================================


def normalize_score(series):

    """
    Converts metric into 0-100 score
    """

    minimum = series.min()

    maximum = series.max()


    if maximum == minimum:

        return pd.Series(

            100,

            index=series.index

        )


    return (

        (series - minimum)

        /

        (maximum - minimum)

        *

        100

    )



