    # ------------------------------------------------


    if (

        "energy_score" in row

        and

        row["energy_score"] < 60

    ):


        recommendations.append(

            "Improve energy efficiency using HVAC optimization, lighting upgrades, and equipment scheduling."

        )


        priority.append(

            "High"

        )



    elif (

        "energy_score" in row

        and

        row["energy_score"] < 75

    ):


        recommendations.append(

            "Perform energy optimization assessment."

        )


        priority.append(

            "Medium"

        )



    # ------------------------------------------------
    # Carbon Reduction
    # ------------------------------------------------


    if (

        "carbon_score" in row

        and

        row["carbon_score"] < 60

    ):


        recommendations.append(

            "Reduce carbon emissions through renewable energy adoption and low-carbon operations."

        )


        priority.append(

            "High"

        )



    # ------------------------------------------------
