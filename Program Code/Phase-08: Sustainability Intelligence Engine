import pandas as pd
import numpy as np
import json
import gc
from pathlib import Path
from datetime import datetime

# ----------------------------------------------------------------
# UTILITY FUNCTIONS & LOGIC
# ----------------------------------------------------------------

def normalize_score(series):
    """Converts a metric into a 0-100 normalized score scale."""
    minimum = series.min()
    maximum = series.max()
    if maximum == minimum:
        return pd.Series(100, index=series.index)
    return ((series - minimum) / (maximum - minimum)) * 100

def find_column(df, names):
    """Finds the first matching column name from a list of possibilities."""
    for name in names:
        if name in df.columns:
            return name
    return None

def generate_recommendations(row):
    """Evaluates building metrics and compiles context-aware action plans and priorities."""
    recommendations = []
    priority = []

    energy_score = row.get("energy_score", row.get("energy_efficiency_score", 50))
    if energy_score < 60:
        recommendations.append("Improve energy efficiency using HVAC optimization, lighting upgrades, and equipment scheduling.")
        priority.append("High")
    elif energy_score < 75:
        recommendations.append("Perform energy optimization assessment.")
        priority.append("Medium")

    carbon_score = row.get("carbon_score", 50)
    if carbon_score < 60:
        recommendations.append("Reduce carbon emissions through renewable energy adoption and low-carbon operations.")
        priority.append("High")

    renewable_score = row.get("renewable_score", 50)
    if renewable_score < 40:
        recommendations.append("Increase renewable energy usage through solar integration.")
        priority.append("Medium")

    risk_score = row.get("risk_score", row.get("energy_risk_score", 50))
    if risk_score < 50:
        recommendations.append("Investigate abnormal energy behaviour and perform infrastructure inspection.")
        priority.append("Critical")

    if not recommendations:
        recommendations.append("Building performance is strong. Continue monitoring sustainability indicators.")
        priority.append("Low")

    max_priority = max(priority, key=lambda x: ["Low", "Medium", "High", "Critical"].index(x))
    return pd.Series({
        "recommendation": " ".join(recommendations),
        "priority": max_priority
    })

# ----------------------------------------------------------------
# MASTER PIPELINE EXECUTION
# ----------------------------------------------------------------

def main():
    PROJECT_ROOT = Path("/content/drive/MyDrive/GitHub_Project_01")
    PROCESSED_DIR = PROJECT_ROOT / "processed"
    REPORT_DIR = PROJECT_ROOT / "reports"

    SUSTAINABILITY_DIR = PROCESSED_DIR / "sustainability"
    DASHBOARD_DIR = SUSTAINABILITY_DIR / "dashboard"
    SUSTAINABILITY_REPORT_DIR = REPORT_DIR / "sustainability"
    PHASE08_REPORT_DIR = SUSTAINABILITY_REPORT_DIR / "phase08"
    DASHBOARD_REPORT_DIR = SUSTAINABILITY_REPORT_DIR / "dashboard"

    # Ensure all directories exist
    for directory in [SUSTAINABILITY_DIR, DASHBOARD_DIR, SUSTAINABILITY_REPORT_DIR, PHASE08_REPORT_DIR, DASHBOARD_REPORT_DIR]:
        directory.mkdir(parents=True, exist_ok=True)

    print("=" * 80)
    print("STARTING COMPLETE PHASE-08 SUSTAINABILITY INTELLIGENCE ENGINE")
    print("=" * 80)

    # ================================================================
    # PART-01: SUSTAINABILITY DATA INTEGRATION
    # ================================================================
    print("\n[PART-01] Running Data Integration...")
    base_path = PROCESSED_DIR / "merged_infrastructure_data.parquet"
    if not base_path.exists():
        base_path = PROCESSED_DIR / "building_master_processed.parquet"

    if base_path.exists():
        df = pd.read_parquet(base_path)
        print(f"Loaded Base Dataset Shape: {df.shape}")
    else:
        print("[WARNING] Base processed dataset not found. Creating placeholder structure.")
        df = pd.DataFrame()

    expected_cols = ["building_id", "electricity", "solar", "total_energy_consumption", "yearbuilt"]
    for col in expected_cols:
        if col not in df.columns:
            df[col] = 0 if col != "building_id" else "Bldg_000"

    integrated_path = SUSTAINABILITY_DIR / "sustainability_integrated_base.parquet"
    df.to_parquet(integrated_path, compression="snappy", index=False)
    del df
    gc.collect()

    # ================================================================
    # PART-02: CARBON EMISSION INTELLIGENCE
    # ================================================================
    print("\n[PART-02] Running Carbon Emission Intelligence...")
    carbon_df = pd.read_parquet(integrated_path)
    GRID_EMISSION_FACTOR = 0.42

    if "total_energy_consumption" in carbon_df.columns:
        carbon_df["total_carbon_emission"] = carbon_df["total_energy_consumption"] * GRID_EMISSION_FACTOR
    elif "electricity" in carbon_df.columns:
        carbon_df["total_carbon_emission"] = carbon_df["electricity"] * GRID_EMISSION_FACTOR
    else:
        carbon_df["total_carbon_emission"] = 0.0

    carbon_df["carbon_intensity_index"] = np.where(
        carbon_df.get("total_energy_consumption", 0) > 0,
        carbon_df["total_carbon_emission"] / carbon_df["total_energy_consumption"],
        0.0
    )

    carbon_output_path = SUSTAINABILITY_DIR / "carbon_emission_results.parquet"
    carbon_df.to_parquet(carbon_output_path, compression="snappy", index=False)

    carbon_summary = pd.DataFrame({
        "Metric": ["Total Records Evaluated", "Mean Carbon Emission", "Max Carbon Emission", "Min Carbon Emission"],
        "Value": [
            len(carbon_df),
            carbon_df["total_carbon_emission"].mean() if len(carbon_df) > 0 else 0,
            carbon_df["total_carbon_emission"].max() if len(carbon_df) > 0 else 0,
            carbon_df["total_carbon_emission"].min() if len(carbon_df) > 0 else 0
        ]
    })
    carbon_summary.to_csv(SUSTAINABILITY_REPORT_DIR / "carbon_emission_summary.csv", index=False)
    del carbon_df
    gc.collect()

    # ================================================================
    # PART-03: ENERGY EFFICIENCY INTELLIGENCE
    # ================================================================
    print("\n[PART-03] Running Energy Efficiency Intelligence...")
    energy_df = pd.read_parquet(carbon_output_path)

    if "total_energy_consumption" in energy_df.columns:
        max_energy = energy_df["total_energy_consumption"].max()
        if max_energy > 0:
            energy_df["energy_efficiency_score"] = (
                100 - (energy_df["total_energy_consumption"] / max_energy * 100)
            ).clip(0, 100)
        else:
            energy_df["energy_efficiency_score"] = 50.0
    else:
        energy_df["energy_efficiency_score"] = 50.0

    energy_df["energy_risk_score"] = np.where(
        energy_df.get("energy_efficiency_score", 50) < 40, 85.0, 15.0
    )

    energy_output_path = SUSTAINABILITY_DIR / "energy_efficiency_results.parquet"
    energy_df.to_parquet(energy_output_path, compression="snappy", index=False)

    energy_summary = pd.DataFrame({
        "Metric": ["Total Records", "Average Energy Efficiency Score", "Average Risk Score"],
        "Value": [
            len(energy_df),
            energy_df["energy_efficiency_score"].mean() if len(energy_df) > 0 else 0,
            energy_df["energy_risk_score"].mean() if len(energy_df) > 0 else 0
        ]
    })
    energy_summary.to_csv(SUSTAINABILITY_REPORT_DIR / "energy_efficiency_summary.csv", index=False)
    del energy_df
    gc.collect()

    # ================================================================
    # PART-04: SUSTAINABILITY FEATURE ENGINEERING
    # ================================================================
    print("\n[PART-04] Running Sustainability Feature Engineering...")
    sustainability_df = pd.read_parquet(energy_output_path)

    if "electricity" in sustainability_df.columns:
        sustainability_df["energy_mean"] = sustainability_df["electricity"].rolling(window=30, min_periods=1).mean()
        sustainability_df["energy_std"] = sustainability_df["electricity"].rolling(window=30, min_periods=1).std().fillna(0)
        sustainability_df["energy_variability_index"] = np.where(
            sustainability_df["energy_mean"] > 0,
            sustainability_df["energy_std"] / sustainability_df["energy_mean"],
            0
        )

    if "total_carbon_emission" in sustainability_df.columns and "total_energy_consumption" in sustainability_df.columns:
        sustainability_df["carbon_per_energy"] = np.where(
            sustainability_df["total_energy_consumption"] > 0,
            sustainability_df["total_carbon_emission"] / sustainability_df["total_energy_consumption"],
            0
        )

    if "solar" in sustainability_df.columns and "total_energy_consumption" in sustainability_df.columns:
        sustainability_df["renewable_ratio"] = np.where(
            sustainability_df["total_energy_consumption"] > 0,
            sustainability_df["solar"] / sustainability_df["total_energy_consumption"],
            0
        )
    else:
        sustainability_df["renewable_ratio"] = 0

    if "energy_risk_score" in sustainability_df.columns:
        sustainability_df["sustainability_risk_factor"] = sustainability_df["energy_risk_score"] / 100

    if "yearbuilt" in sustainability_df.columns:
        sustainability_df["building_age"] = 2026 - sustainability_df["yearbuilt"]

    feature_store_path = SUSTAINABILITY_DIR / "sustainability_feature_store.parquet"
    sustainability_df.to_parquet(feature_store_path, compression="snappy", index=False)

    feature_summary = pd.DataFrame({
        "Feature": list(sustainability_df.columns),
        "Data_Type": [str(dtype) for dtype in sustainability_df.dtypes]
    })
    feature_summary.to_csv(SUSTAINABILITY_REPORT_DIR / "sustainability_feature_summary.csv", index=False)
    del sustainability_df
    gc.collect()

    # ================================================================
    # PART-05: SUSTAINABILITY SCORING MODEL
    # ================================================================
    print("\n[PART-05] Running Sustainability Scoring Model...")
    score_df = pd.read_parquet(feature_store_path)

    score_df["energy_score"] = score_df["energy_efficiency_score"].clip(0, 100) if "energy_efficiency_score" in score_df.columns else 50
    score_df["carbon_score"] = (100 - normalize_score(score_df["total_carbon_emission"])) if "total_carbon_emission" in score_df.columns else 50
    score_df["renewable_score"] = (score_df["renewable_ratio"].clip(0, 1) * 100) if "renewable_ratio" in score_df.columns else 50
    score_df["risk_score"] = (100 - score_df["energy_risk_score"].clip(0, 100)) if "energy_risk_score" in score_df.columns else 50

    score_df["sustainability_score"] = (
        score_df["energy_score"] * 0.35 +
        score_df["carbon_score"] * 0.30 +
        score_df["renewable_score"] * 0.20 +
        score_df["risk_score"] * 0.15
    ).clip(0, 100)

    score_df["sustainability_category"] = np.select(
        [
            score_df["sustainability_score"] >= 85,
            score_df["sustainability_score"] >= 70,
            score_df["sustainability_score"] >= 50
        ],
        ["Excellent", "Good", "Moderate"],
        default="Needs Improvement"
    )

    score_output_path = SUSTAINABILITY_DIR / "sustainability_score_results.parquet"
    score_df.to_parquet(score_output_path, compression="snappy", index=False)

    if "building_id" in score_df.columns:
        building_rank = (
            score_df.groupby("building_id")
            .agg({
                "sustainability_score": "mean",
                "energy_score": "mean",
                "carbon_score": "mean",
                "renewable_score": "mean",
                "risk_score": "mean"
            })
            .reset_index()
        )
        building_rank["sustainability_rank"] = building_rank["sustainability_score"].rank(ascending=False, method="dense").astype(int)
        building_rank = building_rank.sort_values("sustainability_rank")
    else:
        building_rank = pd.DataFrame()

    building_ranking_path = SUSTAINABILITY_DIR / "building_sustainability_ranking.parquet"
    building_rank.to_parquet(building_ranking_path, compression="snappy", index=False)
    building_rank.to_csv(SUSTAINABILITY_REPORT_DIR / "building_sustainability_ranking.csv", index=False)
    del score_df
    gc.collect()

    # ================================================================
    # PART-06: GREEN BUILDING RANKING ENGINE
    # ================================================================
    print("\n[PART-06] Running Green Building Ranking...")
    green_df = pd.read_parquet(score_output_path)

    required_columns = ["building_id", "sustainability_score", "energy_score", "carbon_score", "renewable_score", "risk_score"]
    available_columns = [c for c in required_columns if c in green_df.columns]

    building_green = (
        green_df[available_columns]
        .groupby("building_id")
        .agg({
            "sustainability_score": "mean",
            "energy_score": "mean",
            "carbon_score": "mean",
            "renewable_score": "mean",
            "risk_score": "mean"
        })
        .reset_index()
    )

    building_green["green_index"] = (
        building_green["sustainability_score"] * 0.50 +
        building_green["carbon_score"] * 0.20 +
        building_green["energy_score"] * 0.20 +
        building_green["renewable_score"] * 0.10
    ).clip(0, 100)

    building_green["green_category"] = np.select(
        [
            building_green["green_index"] >= 90,
            building_green["green_index"] >= 75,
            building_green["green_index"] >= 60
        ],
        ["Platinum Green", "Gold Green", "Silver Green"],
        default="Improvement Required"
    )

    building_green["green_rank"] = building_green["green_index"].rank(ascending=False, method="dense").astype(int)
    building_green = building_green.sort_values("green_rank")

    green_ranking_path = SUSTAINABILITY_DIR / "green_building_ranking.parquet"
    building_green.to_parquet(green_ranking_path, compression="snappy", index=False)
    building_green.to_csv(SUSTAINABILITY_REPORT_DIR / "green_building_ranking.csv", index=False)

    top_green = building_green.head(100)
    top_green.to_parquet(SUSTAINABILITY_DIR / "top_green_buildings.parquet", compression="snappy", index=False)
    top_green.to_csv(SUSTAINABILITY_REPORT_DIR / "top_green_buildings.csv", index=False)
    del green_df, building_green
    gc.collect()

    # ================================================================
    # PART-07: SUSTAINABILITY RECOMMENDATION ENGINE
    # ================================================================
    print("\n[PART-07] Running Recommendation Engine...")
    recommend_df = pd.read_parquet(score_output_path)

    recommendations = recommend_df.apply(generate_recommendations, axis=1)
    recommend_df = pd.concat([recommend_df, recommendations], axis=1)

    recommendations_path = SUSTAINABILITY_DIR / "sustainability_recommendations.parquet"
    recommend_df.to_parquet(recommendations_path, compression="snappy", index=False)
    recommend_df.to_csv(SUSTAINABILITY_REPORT_DIR / "sustainability_recommendations.csv", index=False)

    if "building_id" in recommend_df.columns:
        action_plan = (
            recommend_df.groupby("building_id")
            .agg({
                "sustainability_score": "mean",
                "recommendation": lambda x: " | ".join(x.unique()[:5]),
                "priority": lambda x: x.mode()[0]
            })
            .reset_index()
        )
    else:
        action_plan = pd.DataFrame()

    action_plan_path = SUSTAINABILITY_DIR / "building_action_plan.parquet"
    action_plan.to_parquet(action_plan_path, compression="snappy", index=False)
    del recommend_df
    gc.collect()

    # ================================================================
    # PART-08: DASHBOARD DATASET ENGINE
    # ================================================================
    print("\n[PART-08] Running Dashboard Dataset Engine...")
    green_dashboard_df = pd.read_parquet(green_ranking_path)
    action_dashboard_df = pd.read_parquet(action_plan_path)

    building_dashboard = green_dashboard_df.merge(action_dashboard_df, on="building_id", how="left")

    score_col = find_column(building_dashboard, ["sustainability_score", "sustainability_score_x", "sustainability_score_y"])
    green_col = find_column(building_dashboard, ["green_index"])
    cat_col = find_column(building_dashboard, ["green_category"])

    building_dashboard.to_parquet(DASHBOARD_DIR / "building_dashboard_dataset.parquet", compression="snappy", index=False)
    building_dashboard.to_parquet(DASHBOARD_DIR / "sustainability_dashboard_master.parquet", compression="snappy", index=False)

    kpi_records = [["Total Buildings", len(building_dashboard)]]
    if score_col:
        kpi_records.append(["Average Sustainability Score", building_dashboard[score_col].mean()])
    if green_col:
        kpi_records.append(["Average Green Index", building_dashboard[green_col].mean()])
        kpi_records.append(["Highest Green Index", building_dashboard[green_col].max()])
    if cat_col:
        kpi_records.append(["Platinum Green Buildings", sum(building_dashboard[cat_col] == "Platinum Green")])

    kpi_df = pd.DataFrame(kpi_records, columns=["metric", "value"])
    kpi_df.to_parquet(DASHBOARD_DIR / "sustainability_kpi_dataset.parquet", compression="snappy", index=False)

    risk_cols = [c for c in ["building_id", score_col, "risk_score", "green_category", "green_index"] if c is not None and c in building_dashboard.columns]
    building_dashboard[risk_cols].to_parquet(DASHBOARD_DIR / "risk_dashboard_dataset.parquet", compression="snappy", index=False)

    recommend_cols = [c for c in ["building_id", "recommendation", "priority", score_col] if c is not None and c in building_dashboard.columns]
    building_dashboard[recommend_cols].to_parquet(DASHBOARD_DIR / "recommendation_dashboard_dataset.parquet", compression="snappy", index=False)

    kpi_df.to_csv(DASHBOARD_REPORT_DIR / "dashboard_kpi_summary.csv", index=False)
    del green_dashboard_df, action_dashboard_df, building_dashboard
    gc.collect()

    # ================================================================
    # PART-09: AUTOMATED REPORTING ENGINE
    # ================================================================
    print("\n[PART-09] Running Automated Reporting Engine...")
    score_rep = pd.read_parquet(score_output_path)
    green_rep = pd.read_parquet(green_ranking_path)
    recommend_rep = pd.read_parquet(recommendations_path)

    executive_report = pd.DataFrame({
        "Metric": [
            "Total Records", "Buildings Evaluated", "Average Sustainability Score",
            "Highest Sustainability Score", "Lowest Sustainability Score",
            "Average Energy Score", "Average Carbon Score", "Average Renewable Score"
        ],
        "Value": [
            len(score_rep),
            score_rep["building_id"].nunique() if "building_id" in score_rep.columns else 0,
            score_rep["sustainability_score"].mean(),
            score_rep["sustainability_score"].max(),
            score_rep["sustainability_score"].min(),
            score_rep["energy_score"].mean(),
            score_rep["carbon_score"].mean(),
            score_rep["renewable_score"].mean()
        ]
    })
    executive_report.to_csv(PHASE08_REPORT_DIR / "executive_sustainability_report.csv", index=False)

    green_rep.sort_values("green_rank").to_csv(PHASE08_REPORT_DIR / "building_performance_report.csv", index=False)
    green_rep.head(100).to_csv(PHASE08_REPORT_DIR / "green_building_leaderboard.csv", index=False)

    carbon_columns = ["building_id", "carbon_score", "total_carbon_emission", "carbon_per_energy"]
    available_carbon_columns = [c for c in carbon_columns if c in score_rep.columns]
    if len(available_carbon_columns) > 1:
        carbon_report = score_rep[available_carbon_columns].groupby("building_id").mean().reset_index()
    else:
        carbon_report = pd.DataFrame()
    carbon_report.to_csv(PHASE08_REPORT_DIR / "carbon_intelligence_report.csv", index=False)

    recommend_rep_cols = [c for c in ["building_id", "recommendation", "priority"] if c in recommend_rep.columns]
    recommend_rep[recommend_rep_cols].to_csv(PHASE08_REPORT_DIR / "recommendation_intelligence_report.csv", index=False)

    metadata = {
        "project": "Sustainable Infrastructure Intelligence Platform",
        "phase": "PHASE-08 Sustainability Intelligence Engine",
        "generated_date": str(datetime.now()),
        "status": "SUCCESS"
    }
    with open(PHASE08_REPORT_DIR / "phase08_report_metadata.json", "w") as f:
        json.dump(metadata, f, indent=4)

    del score_rep, green_rep, recommend_rep
    gc.collect()

    # ================================================================
    # PART-10: PROJECT RECOVERY LOG & MANIFEST
    # ================================================================
    print("\n[PART-10] Compiling Artifact Inventory & Recovery Log...")
    artifacts = []
    for folder in [SUSTAINABILITY_DIR, DASHBOARD_DIR, PHASE08_REPORT_DIR]:
        if folder.exists():
            for file in sorted(folder.glob("*")):
                artifacts.append({
                    "file_name": file.name,
                    "path": str(file),
                    "type": file.suffix,
                    "size_mb": round(file.stat().st_size / 1024 / 1024, 3)
                })

    artifact_df = pd.DataFrame(artifacts)
    artifact_df.to_csv(PHASE08_REPORT_DIR / "phase08_artifact_inventory.csv", index=False)

    manifest = {
        "project": "Sustainable Infrastructure Intelligence Platform",
        "phase": "PHASE-08 Sustainability Intelligence Engine",
        "completion_time": str(datetime.now()),
        "status": "COMPLETED",
        "next_phase": "PHASE-09 LLM + RAG Sustainability Assistant"
    }

    with open(PHASE08_REPORT_DIR / "phase08_project_manifest.json", "w") as f:
        json.dump(manifest, f, indent=4)

    recovery_log = f"""================================================================================
SUSTAINABLE INFRASTRUCTURE INTELLIGENCE PLATFORM
PHASE-08 COMPLETION LOG
================================================================================
PROJECT: Sustainable Infrastructure Intelligence Platform
STATUS: PHASE-08 COMPLETED SUCCESSFULLY
DATE: {datetime.now()}
NEXT PHASE: PHASE-09 LLM + RAG Sustainability Assistant
================================================================================
"""
    with open(PHASE08_REPORT_DIR / "phase08_project_recovery_log.txt", "w") as f:
        f.write(recovery_log)

    print("=" * 80)
    print("PHASE-08 MASTER PIPELINE COMPLETED SUCCESSFULLY FROM END TO END")
    print("=" * 80)

if __name__ == "__main__":
    main()
