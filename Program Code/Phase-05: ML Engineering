import time


print("ML libraries imported")

def evaluate_model(
    model_name,
    model,
    X_train,
    y_train,
    X_val,
    y_val
):

    start_time = time.time()


    # Training

    model.fit(
        X_train,
        y_train
    )


    training_time = (
        time.time()
        -
        start_time
    )


    # Prediction

    predictions = (
        model.predict(
            X_val
        )
    )


    # Metrics

    mae = mean_absolute_error(
        y_val,
        predictions
    )


    rmse = np.sqrt(
        mean_squared_error(
            y_val,
            predictions
        )
    )


    r2 = r2_score(
        y_val,
        predictions
    )


    results = {

        "Model": model_name,

        "MAE": mae,

        "RMSE": rmse,

        "R2_Score": r2,

        "Training_Time_sec": training_time
    }


    return (
        results,
        predictions
    )

