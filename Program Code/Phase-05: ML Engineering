import os
import warnings
warnings.filterwarnings("ignore")

import time
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
import joblib

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression, Ridge
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer

# Advanced ML Models
from xgboost import XGBRegressor
from lightgbm import LGBMRegressor
import shap

print("Libraries Imported Successfully")

# ============================================================
# 1. PATH SETUP & DATA LOADING
# ============================================================

PROJECT_PATH = "/content/drive/MyDrive/GitHub_Project_01"
FEATURE_STORE = os.path.join(PROJECT_PATH, "processed", "feature_store", "sustainable_feature_store.parquet")

df_ml = pd.read_parquet(FEATURE_STORE)

print("Feature Store Loaded")
print("Shape:", df_ml.shape)

TARGET = "electricity"
if TARGET in df_ml.columns:
    print("Target variable available:", TARGET)
else:
    raise Exception("Target variable not found")

df_ml["date"] = pd.to_datetime(df_ml["date"])
print("Date Range:", df_ml["date"].min(), "to", df_ml["date"].max())

# ============================================================
# 2. FEATURE DEFINITION & DATASET SPLITTING
# ============================================================

time_features = ["year", "month", "day", "weekday", "is_weekend", "season"]
lag_features = ["lag_1", "lag_7", "rolling_7", "rolling_30"]
building_features = [
    "building_type", "primaryspaceusage", "sub_primaryspaceusage",
    "sqm", "sqft", "numberoffloors", "occupants", "yearbuilt"
]
weather_features = [
    "airTemperature", "dewTemperature", "windSpeed", "windDirection",
    "cloudCoverage", "precipDepth1HR", "precipDepth6HR",
    "heating_degree_days", "cooling_degree_days", "temperature_diff"
]
sustainability_features = [
    "eui", "site_eui", "source_eui", "energystarscore", "leed_level"
]

FEATURES = time_features + lag_features + building_features + weather_features + sustainability_features
print("Total ML Features:", len(FEATURES))

missing_features = [col for col in FEATURES if col not in df_ml.columns]
if len(missing_features) == 0:
    print("All features available")
else:
    print("Missing Features:", missing_features)

ml_data = df_ml[FEATURES + [TARGET, "date"]].copy()
ml_data = ml_data.sort_values("date").reset_index(drop=True)

# Time-based Train/Validation/Test Split
train_data = ml_data[ml_data["date"] < "2017-01-01"]
validation_data = ml_data[(ml_data["date"] >= "2017-01-01") & (ml_data["date"] < "2017-07-01")]
test_data = ml_data[ml_data["date"] >= "2017-07-01"]

print("Train:", train_data.shape)
print("Validation:", validation_data.shape)
print("Test:", test_data.shape)

X_train, y_train = train_data[FEATURES], train_data[TARGET]
X_val, y_val = validation_data[FEATURES], validation_data[TARGET]
X_test, y_test = test_data[FEATURES], test_data[TARGET]

# Save split datasets
ML_PATH = os.path.join(PROJECT_PATH, "processed", "ml_dataset")
os.makedirs(ML_PATH, exist_ok=True)

X_train.to_parquet(os.path.join(ML_PATH, "X_train.parquet"))
X_val.to_parquet(os.path.join(ML_PATH, "X_validation.parquet"))
X_test.to_parquet(os.path.join(ML_PATH, "X_test.parquet"))
y_train.to_frame().to_parquet(os.path.join(ML_PATH, "y_train.parquet"))
y_val.to_frame().to_parquet(os.path.join(ML_PATH, "y_validation.parquet"))
y_test.to_frame().to_parquet(os.path.join(ML_PATH, "y_test.parquet"))
print("ML datasets saved successfully")

# ============================================================
# 3. PREPROCESSING PIPELINE SETUP
# ============================================================

force_numeric = ["eui", "site_eui", "source_eui", "energystarscore"]
for col in force_numeric:
    if col in X_train.columns:
        X_train[col] = pd.to_numeric(X_train[col], errors="coerce")
        X_val[col] = pd.to_numeric(X_val[col], errors="coerce")
        X_test[col] = pd.to_numeric(X_test[col], errors="coerce")

numeric_features = X_train.select_dtypes(include=["int64", "float64"]).columns.tolist()
categorical_features = [col for col in X_train.columns if col not in numeric_features]

numeric_pipeline = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ]
)

categorical_pipeline = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("encoder", OneHotEncoder(handle_unknown="ignore"))
    ]
)

preprocessor = ColumnTransformer(
    transformers=[
        ("num", numeric_pipeline, numeric_features),
        ("cat", categorical_pipeline, categorical_features)
    ]
)

X_train_processed = preprocessor.fit_transform(X_train)
X_val_processed = preprocessor.transform(X_val)
X_test_processed = preprocessor.transform(X_test)

MODEL_PATH = os.path.join(PROJECT_PATH, "models")
os.makedirs(MODEL_PATH, exist_ok=True)
joblib.dump(preprocessor, os.path.join(MODEL_PATH, "preprocessor.pkl"))
print("Preprocessor saved successfully")

# ============================================================
# 4. BASELINE MODELS TRAINING & EVALUATION
# ============================================================

def evaluate_model(model_name, model, X_train, y_train, X_val, y_val):
    start_time = time.time()
    model.fit(X_train, y_train)
    training_time = time.time() - start_time
    
    predictions = model.predict(X_val)
    mae = mean_absolute_error(y_val, predictions)
    rmse = np.sqrt(mean_squared_error(y_val, predictions))
    r2 = r2_score(y_val, predictions)
    
    results = {
        "Model": model_name,
        "MAE": mae,
        "RMSE": rmse,
        "R2_Score": r2,
        "Training_Time_sec": training_time
    }
    return results, predictions

# Linear Regression
linear_model = LinearRegression()
linear_results, _ = evaluate_model("Linear Regression", linear_model, X_train_processed, y_train, X_val_processed, y_val)

# Ridge Regression
ridge_model = Ridge(alpha=1.0)
ridge_results, _ = evaluate_model("Ridge Regression", ridge_model, X_train_processed, y_train, X_val_processed, y_val)

# Random Forest
rf_model = RandomForestRegressor(
    n_estimators=50, max_depth=12, min_samples_split=20,
    min_samples_leaf=5, max_features="sqrt", random_state=42, n_jobs=-1
)
rf_results, _ = evaluate_model("Random Forest Optimized", rf_model, X_train_processed, y_train, X_val_processed, y_val)

baseline_results = pd.DataFrame([linear_results, ridge_results, rf_results])
baseline_results_sorted = baseline_results.sort_values("RMSE")

REPORT_PATH = os.path.join(PROJECT_PATH, "reports")
os.makedirs(REPORT_PATH, exist_ok=True)
baseline_results_sorted.to_csv(os.path.join(REPORT_PATH, "baseline_model_results.csv"), index=False)

# ============================================================
# 5. ADVANCED MODELS (XGBOOST & LIGHTGBM)
# ============================================================

def evaluate_advanced_model(model_name, model, X_train, y_train, X_val, y_val):
    start_time = time.time()
    model.fit(X_train, y_train)
    training_time = time.time() - start_time
    
    predictions = model.predict(X_val)
    mae = mean_absolute_error(y_val, predictions)
    rmse = np.sqrt(mean_squared_error(y_val, predictions))
    r2 = r2_score(y_val, predictions)
    
    results = {
        "Model": model_name,
        "MAE": mae,
        "RMSE": rmse,
        "R2_Score": r2,
        "Training_Time_sec": training_time
    }
    return results, predictions, model

# LightGBM Model
lgbm_model = LGBMRegressor(
    n_estimators=300, learning_rate=0.05, num_leaves=64,
    max_depth=10, subsample=0.8, colsample_bytree=0.8,
    random_state=42, n_jobs=-1
)
lgbm_results, lgbm_predictions, lgbm_model = evaluate_advanced_model(
    "LightGBM", lgbm_model, X_train_processed, y_train, X_val_processed, y_val
)

# XGBoost Model
xgb_model = XGBRegressor(
    n_estimators=300, learning_rate=0.05, max_depth=8,
    subsample=0.8, colsample_bytree=0.8, objective="reg:squarederror",
    tree_method="hist", random_state=42, n_jobs=-1
)
xgb_results, xgb_predictions, xgb_model = evaluate_advanced_model(
    "XGBoost", xgb_model, X_train_processed, y_train, X_val_processed, y_val
)

# Combine All Results
advanced_results = pd.DataFrame([xgb_results, lgbm_results])
all_model_results = pd.concat([baseline_results, advanced_results], ignore_index=True)
all_model_results = all_model_results.sort_values("RMSE")

all_model_results.to_csv(os.path.join(REPORT_PATH, "ml_model_comparison.csv"), index=False)

# Save Advanced Models
joblib.dump(xgb_model, os.path.join(MODEL_PATH, "xgboost_energy_model.pkl"))
joblib.dump(lgbm_model, os.path.join(MODEL_PATH, "lightgbm_energy_model.pkl"))
print("Advanced models saved successfully")

# ============================================================
# 6. FINAL TEST EVALUATION & EXPLAINABILITY (SHAP)
# ============================================================

final_predictions = xgb_model.predict(X_test_processed)
test_mae = mean_absolute_error(y_test, final_predictions)
test_rmse = np.sqrt(mean_squared_error(y_test, final_predictions))
test_r2 = r2_score(y_test, final_predictions)

final_test_results = pd.DataFrame({
    "Metric": ["MAE", "RMSE", "R2 Score"],
    "Value": [test_mae, test_rmse, test_r2]
})

prediction_analysis = pd.DataFrame({
    "Actual": y_test.values,
    "Predicted": final_predictions
})
prediction_analysis["Error"] = prediction_analysis["Actual"] - prediction_analysis["Predicted"]

# Feature Importance
feature_importance = pd.DataFrame({
    "Feature": range(len(xgb_model.feature_importances_)),
    "Importance": xgb_model.feature_importances_
}).sort_values("Importance", ascending=False)

# SHAP Explainability Sample
X_sample = X_test_processed[:2000]
explainer = shap.TreeExplainer(xgb_model)
shap_values = explainer.shap_values(X_sample)
print("SHAP values generated successfully")

# Export Final ML Reports
final_test_results.to_csv(os.path.join(REPORT_PATH, "final_test_results.csv"), index=False)
feature_importance.to_csv(os.path.join(REPORT_PATH, "feature_importance.csv"), index=False)

print("=" * 85)
print("PHASE-05 ML ENGINEERING COMPLETE")
print("=" * 85)
