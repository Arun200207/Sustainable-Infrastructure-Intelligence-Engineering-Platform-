# FINAL QUESTION FUNCTION
# ============================================================

def ask_sustainability(question):

    intent = classify_question(question)

    # --------------------------------------------------------
    # NUMERICAL QUESTIONS
    # --------------------------------------------------------

    if intent not in [
        "best_buildings",
        "priority_buildings",
        "rag"
    ]:

        answer = answer_kpi(question, intent)

        return {
            "question": question,
            "intent": intent,
            "answer": answer,
            "source": "Phase-09 KPI",
            "grounded": True
        }

    # --------------------------------------------------------
    # BUILDING QUESTIONS
    # --------------------------------------------------------

    if intent == "best_buildings":

        df = top_buildings(10)

        return {
            "question": question,
            "intent": intent,
            "answer": (
                "The strongest carbon-and-cost performers are:\n\n"
                + format_buildings(df)
            ),
            "source": "Phase-09 Building Intelligence",
            "grounded": True
        }

    if intent == "priority_buildings":

        df = priority_buildings(10)

        return {
            "question": question,
            "intent": intent,
            "answer": (
                "Buildings with the lowest combined sustainability "
                "performance should be prioritized:\n\n"
                + format_buildings(df)
            ),
            "source": "Phase-09 Building Intelligence",
            "grounded": True
        }

    # --------------------------------------------------------
    # FALLBACK
    # --------------------------------------------------------

    return {
        "question": question,
        "intent": "rag",
        "answer": (
            "I could not map this question to a verified Phase-09 "
            "metric. Please ask about energy, carbon, cost, scores, "
            "rankings, or buildings."
        ),
        "source": "Phase-09 Knowledge Base",
        "grounded": True
    }


