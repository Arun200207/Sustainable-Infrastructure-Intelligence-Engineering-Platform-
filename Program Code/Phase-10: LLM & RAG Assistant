# Corrected RAG QA router
# ============================================================================

def rag_answer(question):

    intent = detect_intent(question)

    # ----------------------------------------------------------------------
    # Numerical / ranking questions
    # NEVER ask the LLM to calculate these.
    # ----------------------------------------------------------------------

    if intent in {
        "total_buildings",
        "total_energy",
        "net_carbon",
        "net_cost",
        "average_carbon_score",
        "average_cost_score",
    }:
        answer = answer_kpi(intent)

        return {
            "question": question,
            "intent": intent,
            "answer": answer,
            "source": "Phase-09 KPI",
            "grounded": True
        }

    if intent == "best_buildings":

        return {
            "question": question,
            "intent": intent,
            "answer": (
                "The strongest carbon-and-cost performers are:\n\n"
                + best_buildings(10)
            ),
            "source": "Phase-09 Building Intelligence",
            "grounded": True
        }

    if intent == "priority_buildings":

        return {
            "question": question,
            "intent": intent,
            "answer": (
                "Buildings with the lowest combined sustainability "
                "performance should be prioritized:\n\n"
                + priority_buildings(10)
            ),
            "source": "Phase-09 Building Intelligence",
            "grounded": True
        }

    # ----------------------------------------------------------------------
    # General questions can continue through your existing vector + LLM
    # pipeline.
    # ----------------------------------------------------------------------

    return rag_general_answer(question)

