def detect_intent(question):

    q = question.lower().strip()

    if any(x in q for x in [
        "how many buildings",
        "number of buildings",
        "total buildings"
    ]):
        return "total_buildings"

    if any(x in q for x in [
        "total energy",
        "energy consumption",
        "energy consumed"
    ]):
        return "total_energy"

    if any(x in q for x in [
        "net carbon",
        "net emissions",
        "carbon emissions"
    ]):
        return "net_carbon"

    if any(x in q for x in [
        "net energy cost",
        "net cost",
        "estimated net cost"
    ]):
        return "net_cost"

    if "average carbon score" in q:
        return "average_carbon_score"

    if "average cost score" in q:
        return "average_cost_score"

    if any(x in q for x in [
        "strongest",
        "best performing",
        "best buildings",
        "best performance"
    ]):
        return "best_buildings"

    if any(x in q for x in [
        "prioritized",
        "prioritize",
        "intervention",
        "worst buildings",
        "needs improvement"
    ]):
        return "priority_buildings"

    return "rag_general"

