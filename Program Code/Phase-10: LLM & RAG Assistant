def classify_question(question):

    q = question.lower().strip()

    if any(x in q for x in [
        "how many buildings",
        "number of buildings",
        "total buildings",
        "buildings included"
    ]):
        return "total_buildings"

    if any(x in q for x in [
        "total energy",
        "energy consumption",
        "energy consumed",
        "energy use"
    ]):
        return "total_energy"

    if any(x in q for x in [
        "net carbon",
        "total net carbon"
    ]):
        return "net_carbon"

    if any(x in q for x in [
        "gross carbon",
        "total gross carbon"
    ]):
        return "gross_carbon"

    if any(x in q for x in [
        "solar carbon",
        "carbon avoided",
        "carbon avoidance"
    ]):
        return "solar_carbon"

    if any(x in q for x in [
        "net energy cost",
        "total net cost",
        "estimated net energy cost"
    ]):
        return "net_cost"

    if any(x in q for x in [
        "gross energy cost",
        "gross cost",
        "total cost"
    ]):
        return "gross_cost"

    if any(x in q for x in [
        "solar savings",
        "energy savings"
    ]):
        return "solar_savings"

    if "average carbon score" in q:
        return "average_carbon_score"

    if "average cost score" in q:
        return "average_cost_score"

    if any(x in q for x in [
        "strongest carbon",
        "strongest cost",
        "best carbon",
        "best cost",
        "best performance",
        "excellent carbon and cost"
    ]):
        return "best_buildings"

    if any(x in q for x in [
        "prioritized",
        "priority",
        "intervention",
        "needs intervention"
    ]):
        return "priority_buildings"

    return "rag"


