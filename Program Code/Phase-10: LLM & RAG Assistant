    if intent == "gross_carbon":
        value = get_kpi_value("gross_carbon_tco2e")
        return f"Gross carbon emissions are {value:,.6f} tCO2e."

    if intent == "solar_carbon":
        value = get_kpi_value("solar_carbon_avoided_tco2e")
        return f"Solar generation avoids approximately {value:,.6f} tCO2e."

    if intent == "net_carbon":
        value = get_kpi_value("net_carbon_tco2e")
        return f"Net carbon emissions are {value:,.6f} tCO2e."

    if intent == "gross_cost":
        value = get_kpi_value("gross_energy_cost_usd")
        return f"Gross energy cost is ${value:,.2f}."

    if intent == "solar_savings":
        value = get_kpi_value("solar_savings_usd")
        return f"Solar energy provides approximately ${value:,.2f} in savings."

    if intent == "net_cost":
        value = get_kpi_value("net_energy_cost_usd")
        return f"Net energy cost is ${value:,.2f}."

    if intent == "average_carbon_score":
        value = get_kpi_value("average_carbon_score")
        return f"The average carbon score is {value:.6f}."

    if intent == "average_cost_score":
        value = get_kpi_value("average_cost_score")
        return f"The average cost score is {value:.6f}."

    return None


