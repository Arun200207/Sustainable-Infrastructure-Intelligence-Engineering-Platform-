def top_buildings(n=10):

    cols = [
        "building_id",
        "building_name",
        "campus",
        "building_type",
        "carbon_score",
        "cost_score",
        "carbon_cost_score",
        "carbon_cost_category",
        "overall_rank"
    ]

    available = [c for c in cols if c in phase09_building.columns]

    result = (
        phase09_building[available]
        .sort_values(
            "carbon_cost_score",
            ascending=False
        )
        .head(n)
        .copy()
    )

    return result


def priority_buildings(n=10):

    cols = [
        "building_id",
        "building_name",
        "campus",
        "building_type",
        "carbon_score",
        "cost_score",
        "carbon_cost_score",
        "carbon_cost_category",
        "overall_rank"
    ]

    result = (
        phase09_building[cols]
        .sort_values(
            ["carbon_cost_score", "overall_rank"],
            ascending=[True, True]
        )
        .head(n)
        .copy()
    )

    return result


def format_buildings(df):

    lines = []

    for i, row in enumerate(df.itertuples(index=False), 1):

        lines.append(
            f"{i}. {row.building_name} "
            f"(Building ID: {row.building_id}) | "
            f"Carbon Score: {row.carbon_score:.4f} | "
            f"Cost Score: {row.cost_score:.4f} | "
            f"Combined Score: {row.carbon_cost_score:.4f} | "
            f"Category: {row.carbon_cost_category} | "
            f"Overall Rank: {int(row.overall_rank)}"
        )

    return "\n".join(lines)


print("✓ Building answer engine ready")


