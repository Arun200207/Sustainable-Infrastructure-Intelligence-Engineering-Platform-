import numpy as np
import pandas as pd
from sentence_transformers import SentenceTransformer

warnings.filterwarnings("ignore")

# ============================================================================
# 1. CONFIGURATION & ENVIRONMENT SETUP
# ============================================================================

PROJECT_ROOT = Path("/content/gdrive/MyDrive/GitHub_Project_01")
PROCESSED_DIR = PROJECT_ROOT / "processed"
REPORTS_DIR = PROJECT_ROOT / "reports"

PHASE10_PROCESSED = PROCESSED_DIR / "phase10_rag"
PHASE10_REPORTS = REPORTS_DIR / "phase10_rag"
PHASE10_KB = PHASE10_PROCESSED / "knowledge_base"
PHASE10_VECTOR = PHASE10_PROCESSED / "vector_store"

# Ensure all directories exist
for directory in [PHASE10_PROCESSED, PHASE10_REPORTS, PHASE10_KB, PHASE10_VECTOR]:
    directory.mkdir(parents=True, exist_ok=True)

# File paths
KPI_PATH = REPORTS_DIR / "sustainability" / "phase09_carbon_cost_kpis.json"
MASTER_PATH = PROCESSED_DIR / "sustainability" / "carbon_cost_master.parquet"
BUILDING_PATH = PROCESSED_DIR / "sustainability" / "carbon_cost_building_intelligence.parquet"
KB_PATH = PHASE10_KB / "sustainability_knowledge.json"

EMBED_MODEL = "sentence-transformers/all-MiniLM-L6-v2"


# ============================================================================
# 2. SOURCE VERIFICATION & DATA LOADING
# ============================================================================

def validate_and_load_sources():
    """Validates existence of required Phase-09 files and loads core datasets."""
    required_sources = {
        "phase09_master": MASTER_PATH,
        "phase09_building": BUILDING_PATH,
        "phase09_kpi": KPI_PATH,
        "phase09_factor_config": PROCESSED_DIR / "sustainability" / "carbon" / "phase09_factor_configuration.json",
        "phase09_validation": REPORTS_DIR / "sustainability" / "phase09_repair_validation_report.json"
    }

    missing = [name for name, path in required_sources.items() if not path.exists()]
    if missing:
        raise FileNotFoundError(f"Missing required Phase-10 knowledge sources: {missing}")

    master_df = pd.read_parquet(MASTER_PATH)
    building_df = pd.read_parquet(BUILDING_PATH)
    
    with open(KPI_PATH, "r") as f:
        kpi_data = json.load(f)

    return master_df, building_df, kpi_data


# ============================================================================
# 3. KNOWLEDGE BASE & VECTOR STORE BUILDER
# ============================================================================

def build_knowledge_base(building_df: pd.DataFrame, kpi_data: dict) -> Path:
    """Extracts structured knowledge records and saves to JSON."""
    building_records = building_df.to_dict(orient="records")
    knowledge = []

    # Global KPI document
    knowledge.append({
        "metadata": {
            "source": "Phase-09 KPI",
            "type": "global_kpi",
            "title": "Phase-09 Carbon and Cost Overview"
        },
        "content": kpi_data
    })

    # Building documents
    for row in building_records:
        knowledge.append({
            "metadata": {
                "source": "Phase-09 Building Intelligence",
                "type": "building",
                "title": f"Building {row.get('building_name', row.get('building_id'))}",
                "building_id": row["building_id"],
            },
            "content": row
        })

    with open(KB_PATH, "w") as f:
        json.dump(knowledge, f, indent=2, default=str)

    return KB_PATH


def build_vector_store():
    """Encodes knowledge documents and persists embeddings using numpy and pickle."""
    if PHASE10_VECTOR.exists():
        shutil.rmtree(PHASE10_VECTOR)
    PHASE10_VECTOR.mkdir(parents=True, exist_ok=True)

    with open(KB_PATH, "r") as f:
        knowledge = json.load(f)

    documents = []
    for item in knowledge:
        metadata = item["metadata"]
        content = item["content"]
        text = (
            f"Source: {metadata.get('source')}\n"
            f"Title: {metadata.get('title')}\n"
            f"Type: {metadata.get('type')}\n"
            f"Building ID: {metadata.get('building_id', '')}\n\n"
            f"{json.dumps(content, indent=2, default=str)}"
        )
        documents.append({"text": text, "metadata": metadata})

    embedder = SentenceTransformer(EMBED_MODEL)
    texts = [doc["text"] for doc in documents]
    embeddings = embedder.encode(texts, show_progress_bar=True, normalize_embeddings=True)

    np.save(PHASE10_VECTOR / "embeddings.npy", np.asarray(embeddings, dtype=np.float32))
    with open(PHASE10_VECTOR / "documents.pkl", "wb") as f:
        pickle.dump(documents, f)

    with open(PHASE10_VECTOR / "metadata.json", "w") as f:
        json.dump({
            "embedding_model": EMBED_MODEL,
            "dimension": int(embeddings.shape[1]),
            "document_count": len(documents)
        }, f, indent=2)


# ============================================================================
# 4. DETERMINISTIC ENGINES (KPI & RANKING)
# ============================================================================

def answer_kpi(intent: str) -> str:
    """Returns authoritative deterministic KPI strings."""
    with open(KPI_PATH, "r") as f:
        k = json.load(f)

    answers = {
        "total_buildings": f"The sustainability platform includes {k['total_buildings']:,} buildings.",
        "total_energy": f"Total energy consumption is {k['total_energy_kwh']:,.6f} kWh.",
        "net_carbon": f"Net carbon emissions are {k['net_carbon_tco2e']:,.6f} tCO2e.",
        "net_cost": f"Net energy cost is ${k['net_energy_cost_usd']:,.2f}.",
        "average_carbon_score": f"The average carbon score is {k['average_carbon_score']:.6f}.",
        "average_cost_score": f"The average cost score is {k['average_cost_score']:.6f}.",
    }
    return answers.get(intent, "Metric not found.")


def format_building_record(row: pd.Series, position: int) -> str:
    """Formats a single building record for readable output."""
    return (
        f"{position}. {row['building_name']} "
        f"(Building ID: {row['building_id']}) | "
        f"Carbon Score: {row['carbon_score']:.4f} | "
        f"Cost Score: {row['cost_score']:.4f} | "
        f"Combined Score: {row['carbon_cost_score']:.4f} | "
        f"Category: {row['carbon_cost_category']} | "
        f"Overall Rank: {int(row['overall_rank'])}"
    )


def get_best_buildings(building_df: pd.DataFrame, n: int = 10) -> str:
    """Returns top-performing buildings based on combined scores."""
    result = building_df.sort_values(
        ["carbon_cost_score", "overall_rank"],
        ascending=[False, True],
        kind="mergesort"
    ).head(n)
    return "\n".join(format_building_record(row, i + 1) for i, (_, row) in enumerate(result.iterrows()))


def get_priority_buildings(building_df: pd.DataFrame, n: int = 10) -> str:
    """Returns buildings requiring priority sustainability intervention."""
    result = building_df.sort_values(
        ["carbon_cost_score", "overall_rank"],
        ascending=[True, False],
        kind="mergesort"
    ).head(n)
    return "\n".join(format_building_record(row, i + 1) for i, (_, row) in enumerate(result.iterrows()))


# ============================================================================
# 5. INTENT DETECTION & RAG ROUTER
# ============================================================================

def detect_intent(question: str) -> str:
    """Classifies user queries into deterministic intents or general RAG."""
    q = question.lower().strip()

    if any(x in q for x in ["how many buildings", "number of buildings", "total buildings"]):
        return "total_buildings"
    if any(x in q for x in ["total energy", "energy consumption", "energy consumed"]):
        return "total_energy"
    if any(x in q for x in ["net carbon", "net emissions", "carbon emissions"]):
        return "net_carbon"
    if any(x in q for x in ["net energy cost", "net cost", "estimated net cost"]):
        return "net_cost"
    if "average carbon score" in q:
        return "average_carbon_score"
    if "average cost score" in q:
        return "average_cost_score"
    if any(x in q for x in ["strongest", "best performing", "best buildings", "best performance"]):
        return "best_buildings"
    if any(x in q for x in ["prioritized", "prioritize", "intervention", "worst buildings", "needs improvement"]):
        return "priority_buildings"

    return "rag_general"


def process_query(question: str, building_df: pd.DataFrame) -> dict:
    """Routes queries to appropriate deterministic or retrieval engines."""
    intent = detect_intent(question)

    if intent in {"total_buildings", "total_energy", "net_carbon", "net_cost", "average_carbon_score", "average_cost_score"}:
        return {
            "question": question,
            "intent": intent,
            "answer": answer_kpi(intent),
            "source": "Phase-09 KPI",
            "grounded": True
        }

    if intent == "best_buildings":
        return {
            "question": question,
            "intent": intent,
            "answer": "The strongest carbon-and-cost performers are:\n\n" + get_best_buildings(building_df, 10),
            "source": "Phase-09 Building Intelligence",
            "grounded": True
        }

    if intent == "priority_buildings":
        return {
            "question": question,
            "intent": intent,
            "answer": "Buildings with the lowest combined sustainability performance should be prioritized:\n\n" + get_priority_buildings(building_df, 10),
            "source": "Phase-09 Building Intelligence",
            "grounded": True
        }

    return {
        "question": question,
        "intent": "rag_general",
        "answer": "General RAG fallback query processed.",
        "source": "Knowledge Base",
        "grounded": True
    }


