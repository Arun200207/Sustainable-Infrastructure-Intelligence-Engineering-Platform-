def format_building(row, position):

    return (
        f"{position}. {row['building_name']} "
        f"(Building ID: {row['building_id']}) | "
        f"Carbon Score: {row['carbon_score']:.4f} | "
        f"Cost Score: {row['cost_score']:.4f} | "
        f"Combined Score: {row['carbon_cost_score']:.4f} | "
        f"Category: {row['carbon_cost_category']} | "
        f"Overall Rank: {int(row['overall_rank'])}"
    )


def best_buildings(n=10):

    result = (
        building
        .sort_values(
            ["carbon_cost_score", "overall_rank"],
            ascending=[False, True],
            kind="mergesort"
        )
        .head(n)
    )

    return "\n".join(
        format_building(row, i + 1)
        for i, (_, row) in enumerate(result.iterrows())
    )


def priority_buildings(n=10):

    result = (
        building
        .sort_values(
            ["carbon_cost_score", "overall_rank"],
            ascending=[True, False],
            kind="mergesort"
        )
        .head(n)
    )

    return "\n".join(
        format_building(row, i + 1)
        for i, (_, row) in enumerate(result.iterrows())
    )

