"""
Phase-13 Core Validation Engine.
Handles KPI checks, recursive searching, artifact verification, and syntax validation.
"""

import ast
import json
from pathlib import Path
import pandas as pd


class Phase13Validator:
    def __init__(self, project_root: Path):
        self.project_root = Path(project_root)
        self.kpi_path = self.project_root / "reports/sustainability/phase09_carbon_cost_kpis.json"
        self.building_intelligence_path = self.project_root / "processed/sustainability/carbon_cost_building_intelligence.parquet"
        self.xai_path = self.project_root / "processed/phase11_xai/xai_test_feature_dataset.parquet"
        self.building_report_dir = self.project_root / "reports/phase12_reporting/building_reports"
        self.dashboard_path = self.project_root / "app/streamlit_app.py"
        self.master_path = self.project_root / "processed/sustainability/sustainability_master_dataset.parquet"

        self.expected_kpis = {
            "buildings": 1578,
            "daily_records": 1153518,
            "total_energy_kwh": 24587506120.897263,
            "net_carbon_tco2e": 8391336.56792361,
            "net_energy_cost_usd": 2704795667.916606,
            "average_carbon_score": 97.966886447,
            "average_cost_score": 97.976268165,
        }

        self.aliases = {
            "buildings": {"buildings", "building_count", "total_buildings", "number_of_buildings"},
            "daily_records": {"daily_records", "daily_record_count", "record_count", "records", "total_records"},
            "total_energy_kwh": {"total_energy_kwh", "total_energy", "energy_kwh", "total_energy_consumption_kwh"},
            "net_carbon_tco2e": {"net_carbon_tco2e", "net_carbon", "carbon_tco2e", "net_carbon_emissions"},
            "net_energy_cost_usd": {"net_energy_cost_usd", "net_energy_cost", "energy_cost_usd", "net_cost"},
            "average_carbon_score": {"average_carbon_score", "avg_carbon_score", "carbon_score"},
            "average_cost_score": {"average_cost_score", "avg_cost_score", "cost_score"},
        }

    def _find_key_recursive(self, obj, target_keys):
        if isinstance(obj, dict):
            for key, value in obj.items():
                if str(key).strip().lower() in target_keys:
                    return value
            for value in obj.values():
                res = self._find_key_recursive(value, target_keys)
                if res is not None:
                    return res
        elif isinstance(obj, list):
            for item in obj:
                res = self._find_key_recursive(item, target_keys)
                if res is not None:
                    return res
        return None

    def validate_kpis(self) -> dict:
        with open(self.kpi_path, "r", encoding="utf-8") as f:
            kpi_data = json.load(f)

        actual_kpis = {}
        for metric, keys in self.aliases.items():
            val = self._find_key_recursive(kpi_data, keys)
            if val is not None:
                try:
                    val = float(val)
                except ValueError:
                    pass
            actual_kpis[metric] = val

        # Building intelligence fallback
        building_df = pd.read_parquet(self.building_intelligence_path)
        building_count = building_df["building_id"].nunique()
        if actual_kpis.get("buildings") is None:
            actual_kpis["buildings"] = building_count

        # Daily records fallback
        if actual_kpis.get("daily_records") is None and self.master_path.exists():
            master_df = pd.read_parquet(self.master_path, columns=["building_id"])
            actual_kpis["daily_records"] = len(master_df)

        kpi_validation = {}
        for metric, expected in self.expected_kpis.items():
            actual = actual_kpis.get(metric)
            if metric in {"buildings", "daily_records"}:
                passed = actual is not None and int(actual) == int(expected)
            else:
                passed = actual is not None and abs(float(actual) - float(expected)) <= 1e-5

            kpi_validation[metric] = {
                "pass": bool(passed),
                "actual": actual,
                "expected": expected
            }
        return kpi_validation

    def validate_xai_and_reports(self) -> tuple[dict, dict, int]:
        xai_df = pd.read_parquet(self.xai_path)
        xai_count = len(xai_df)
        xai_check = {"pass": xai_count == 110, "actual": xai_count, "expected": 110}

        building_reports = list(self.building_report_dir.iterdir()) if self.building_report_dir.exists() else []
        report_count = len([p for p in building_reports if p.is_file()])
        report_check = {"pass": report_count == 1578, "actual": report_count, "expected": 1578}

        building_df = pd.read_parquet(self.building_intelligence_path)
        building_count = building_df["building_id"].nunique()

        return xai_check, report_check, building_count

    def validate_dashboard(self) -> tuple[bool, bool, dict]:
        source = self.dashboard_path.read_text(encoding="utf-8")
        try:
            ast.parse(source)
            syntax_pass = True
        except Exception:
            syntax_pass = False

        lower_source = source.lower()
        content_checks = {
            "streamlit": "import streamlit" in lower_source or "from streamlit" in lower_source,
            "plotly": "plotly" in lower_source,
            "phase09": "phase09" in lower_source,
            "building_data": "building" in lower_source,
            "forecast": "forecast" in lower_source,
            "xai": "xai" in lower_source,
            "rag": "rag" in lower_source,
        }
        content_pass = all(content_checks.values())
        return syntax_pass, content_pass, content_checks

"""
Dashboard contract verification module.
"""

from pathlib import Path

def verify_dashboard_contract(dashboard_path: Path) -> tuple[bool, dict]:
    source = dashboard_path.read_text(encoding="utf-8").lower()
    contract = {
        "streamlit": "streamlit" in source,
        "plotly": "plotly" in source,
        "kpi": "kpi" in source,
        "building": "building" in source,
        "ranking": "rank" in source,
        "energy": "energy" in source,
        "carbon": "carbon" in source,
        "cost": "cost" in source,
        "forecast": "forecast" in source,
        "xai": "xai" in source,
        "rag": "rag" in source,
        "report": "report" in source,
    }
    return all(contract.values()), contract


"""
Final artifact inventory verification module.
"""

from pathlib import Path

def get_required_artifacts(project_root: Path) -> dict:
    return {
        "streamlit_dashboard": project_root / "app/streamlit_app.py",
        "phase13_report": project_root / "reports/phase13_dashboard/phase13_final_validation.json",
        "phase09_kpi": project_root / "reports/sustainability/phase09_carbon_cost_kpis.json",
        "phase09_building_intelligence": project_root / "processed/sustainability/carbon_cost_building_intelligence.parquet",
        "phase09_carbon_ranking": PROJECT_ROOT / "processed/sustainability/carbon/carbon_building_ranking.parquet",
        "phase09_cost_ranking": PROJECT_ROOT / "processed/sustainability/cost/cost_building_ranking.parquet",
        "phase11_xai": PROJECT_ROOT / "processed/phase11_xai/xai_test_feature_dataset.parquet",
        "phase12_report": PROJECT_ROOT / "reports/phase12_reporting/phase12_sustainability_report.json",
        "phase12_building_reports": PROJECT_ROOT / "reports/phase12_reporting/building_reports",
    }


"""
Master Phase-13 Execution & Completion Script.
Runs all validations, checks contracts, verifies inventory, and prints the completion gate.
"""

import json
from pathlib import Path
import sys

# Add project root to path
PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.append(str(PROJECT_ROOT))

from pipeline.final_validator import Phase13Validator
from pipeline.contract_validator import verify_dashboard_contract
from pipeline.inventory_checker import get_required_artifacts


def main():
    print("=" * 60)
    print("PHASE-13: MASTER PIPELINE EXECUTION & VALIDATION")
    print("=" * 60)

    validator = Phase13Validator(PROJECT_ROOT)

    # 1. Run KPI & Artifact Validation
    kpi_validation = validator.validate_kpis()
    xai_check, report_check, building_count = validator.validate_xai_and_reports()
    syntax_pass, content_pass, content_checks = validator.validate_dashboard()

    all_kpis_pass = all(item["pass"] for item in kpi_validation.values())
    overall_pass = (
        all_kpis_pass
        and building_count == 1578
        and xai_check["pass"]
        and report_check["pass"]
        and syntax_pass
        and content_pass
    )

    # 2. Compile Final Report Dictionary
    final_report = {
        "phase": "Phase-13",
        "status": "PASS" if overall_pass else "FAIL",
        "checks": {
            "authoritative_kpis": kpi_validation,
            "building_count": {"pass": building_count == 1578, "actual": int(building_count), "expected": 1578},
            "xai_prediction_count": xai_check,
            "building_report_count": report_check,
            "dashboard_syntax": {"pass": syntax_pass},
            "dashboard_content": {"pass": content_pass, "checks": content_checks},
        }
    }

    # Save Report
    report_dir = PROJECT_ROOT / "reports/phase13_dashboard"
    report_dir.mkdir(parents=True, exist_ok=True)
    validation_path = report_dir / "phase13_final_validation.json"

    with open(validation_path, "w", encoding="utf-8") as f:
        json.dump(final_report, f, indent=2, default=str)

    print(f"\nValidation report saved to: {validation_path}")

    # 3. Contract & Inventory Verifications
    contract_pass, contract_details = verify_dashboard_contract(validator.dashboard_path)
    artifacts = get_required_artifacts(PROJECT_ROOT)
    inventory_pass = all(path.exists() for path in artifacts.values())

    # 4. Final Completion Gate Verdict
    building_reports_dir = validator.building_report_dir
    building_report_count = len(list(building_reports_dir.iterdir())) if building_reports_dir.exists() else 0

    print("\n" + "=" * 60)
    print("PHASE-13 COMPLETION GATE")
    print("=" * 60)
    print(f"Validation Report Status : {'PASS' if validation_path.exists() and overall_pass else 'FAIL'}")
    print(f"Dashboard Contract       : {'PASS' if contract_pass else 'FAIL'}")
    print(f"Artifact Inventory       : {'PASS' if inventory_pass else 'FAIL'}")
    print(f"Building Reports Count   : {building_report_count} / 1578")

    if overall_pass and contract_pass and inventory_pass and building_report_count == 1578:
        print("\n🟢 PHASE-13 COMPLETE — PASS")
        print("\nCompleted components:")
        print("✓ Streamlit dashboard & Plotly visualizations")
        print("✓ Authoritative KPI & building intelligence integration")
        print("✓ XAI predictions & RAG interface")
        print("✓ Machine-readable JSON validation report")
        print("\nNEXT PHASE:")
        print("PHASE-14 — MLFLOW + INFERENCE PIPELINE")
    else:
        print("\n🔴 PHASE-13 NOT COMPLETE")
        sys.exit(1)


if __name__ == "__main__":
    main()

