building_risk = (

    df_predictions

    .groupby("building_id")

    .agg(

        average_energy_risk=(

            "energy_risk_score",

            "mean"

        ),

        maximum_energy_risk=(

            "energy_risk_score",

            "max"

        ),

        anomaly_count=(

            "isolation_anomaly",

            "sum"

        ),

        total_records=(

            "energy_risk_score",

            "count"

        )

    )

    .reset_index()

)



building_risk["risk_rank"] = (

    building_risk[

        "average_energy_risk"

    ]

    .rank(

        ascending=False

    )

)



