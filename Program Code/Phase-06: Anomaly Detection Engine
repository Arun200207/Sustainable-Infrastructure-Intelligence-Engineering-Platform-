import os
import warnings
warnings.filterwarnings("ignore")

import joblib
import numpy as np
import pandas as pd
from pathlib import Path
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.ensemble import IsolationForest
from sklearn.neighbors import LocalOutlierFactor
from sklearn.preprocessing import StandardScaler

print("=" * 90)
print("PHASE-06 : ANOMALY DETECTION ENGINE INITIALIZED")
print("=" * 90)

# ==============================================================================
# 1. ENVIRONMENT & MODEL LOADING SETUP
# ==============================================================================

try:
    from google.colab import drive
    if not os.path.exists("/content/drive/MyDrive"):
        drive.mount("/content/drive")
except Exception:
    pass

DRIVE_ROOT = Path("/content/drive/MyDrive")
if not DRIVE_ROOT.exists():
    # Fallback to current working directory root if not in Colab
    DRIVE_ROOT = Path(os.getcwd())

def find_file(filename):
    matches = list(DRIVE_ROOT.rglob(filename))
    if len(matches) == 0:
        return None
    return matches[0]

FEATURE_STORE_PATH = find_file("sustainable_feature_store.parquet")
PREPROCESSOR_PATH = find_file("preprocessor.pkl")
XGB_MODEL_PATH = find_file("xgboost_energy_model.pkl")
LGB_MODEL_PATH = find_file("lightgbm_energy_model.pkl")

files = {
    "Feature Store": FEATURE_STORE_PATH,
    "Preprocessor": PREPROCESSOR_PATH,
    "XGBoost Model": XGB_MODEL_PATH,
    "LightGBM Model": LGB_MODEL_PATH
}

missing = [name for name, path in files.items() if path is None]
if len(missing) > 0:
    raise FileNotFoundError("\nMissing Files:\n" + "\n".join(missing))

PROJECT_PATH = FEATURE_STORE_PATH.parents[2]
MODELS_PATH = PROJECT_PATH / "models"
REPORTS_PATH = PROJECT_PATH / "reports"
PROCESSED_PATH = PROJECT_PATH / "processed"

print(f"Project Directory : {PROJECT_PATH}")

# Load Artifacts
df = pd.read_parquet(FEATURE_STORE_PATH)
preprocessor = joblib.load(PREPROCESSOR_PATH)
xgb_model = joblib.load(XGB_MODEL_PATH)
lgb_model = joblib.load(LGB_MODEL_PATH)

print("✅ Feature Store, Preprocessor, and Models Loaded Successfully")

# ==============================================================================
# 2. GENERATE PREDICTIONS & RESIDUAL FEATURES
# ==============================================================================

TARGET = "electricity"
if TARGET not in df.columns:
    raise Exception("Target column 'electricity' not found in dataset.")

feature_columns = list(preprocessor.feature_names_in_)
X = df[feature_columns].copy()

# Fix Numeric Types for String-based Columns
numeric_string_columns = ["eui", "site_eui", "source_eui", "energystarscore"]
for col in numeric_string_columns:
    if col in X.columns:
        X[col] = X[col].replace(["Unknown", "", "NA", "None"], np.nan)
        X[col] = pd.to_numeric(X[col], errors="coerce")

X_processed = preprocessor.transform(X)
predictions = xgb_model.predict(X_processed)

df_predictions = df.copy()
df_predictions["prediction"] = predictions
df_predictions["residual"] = df_predictions[TARGET] - df_predictions["prediction"]
df_predictions["absolute_error"] = df_predictions["residual"].abs()
df_predictions["percentage_error"] = (df_predictions["absolute_error"] / (df_predictions[TARGET].abs() + 1e-6)) * 100

print("✅ Base Predictions and Residuals Computed")

# ==============================================================================
# 3. STATISTICAL ANOMALY DETECTION (Z-SCORE)
# ==============================================================================

residual_mean = df_predictions["residual"].mean()
residual_std = df_predictions["residual"].std()

df_predictions["residual_zscore"] = (df_predictions["residual"] - residual_mean) / residual_std

def anomaly_label(z):
    z = abs(z)
    if z < 2:
        return "Normal"
    elif z < 3:
        return "Moderate"
    elif z < 4:
        return "High"
    else:
        return "Critical"

df_predictions["statistical_anomaly_level"] = df_predictions["residual_zscore"].apply(anomaly_label)
df_predictions["is_statistical_anomaly"] = (df_predictions["residual_zscore"].abs() >= 3).astype(int)

print("✅ Statistical Z-Score Anomaly Engine Executed")

# ==============================================================================
# 4. ISOLATION FOREST ANOMALY DETECTION
# ==============================================================================

anomaly_features = [
    "electricity", "prediction", "residual", "absolute_error",
    "lag_1", "lag_7", "rolling_7", "rolling_30",
    "airTemperature", "dewTemperature", "windSpeed", "temperature_diff",
    "heating_degree_days", "cooling_degree_days",
    "eui", "site_eui", "source_eui", "energystarscore"
]
available_features = [col for col in anomaly_features if col in df_predictions.columns]

X_anomaly = df_predictions[available_features].copy()
for col in X_anomaly.columns:
    X_anomaly[col] = X_anomaly[col].replace(["Unknown", "", "NA", "None"], np.nan)
    X_anomaly[col] = pd.to_numeric(X_anomaly[col], errors="coerce")

X_anomaly = X_anomaly.fillna(X_anomaly.median())

iso_model = IsolationForest(n_estimators=200, contamination=0.02, random_state=42, n_jobs=-1)
iso_model.fit(X_anomaly)

df_predictions["isolation_score"] = iso_model.decision_function(X_anomaly)
df_predictions["isolation_prediction"] = iso_model.predict(X_anomaly)
df_predictions["isolation_anomaly"] = df_predictions["isolation_prediction"].map({1: 0, -1: 1})

joblib.dump(iso_model, MODELS_PATH / "isolation_forest.pkl")
print("✅ Isolation Forest Model Trained & Saved")

# ==============================================================================
# 5. LOCAL OUTLIER FACTOR (LOF) DETECTION
# ==============================================================================

lof_features = [
    "electricity", "prediction", "residual", "absolute_error",
    "lag_1", "lag_7", "rolling_7", "rolling_30",
    "airTemperature", "dewTemperature", "windSpeed", "temperature_diff",
    "heating_degree_days", "cooling_degree_days"
]
available_lof_features = [col for col in lof_features if col in df_predictions.columns]

X_lof = df_predictions[available_lof_features].copy()
for col in X_lof.columns:
    X_lof[col] = X_lof[col].replace(["Unknown", "", "NA", "None"], np.nan)
    X_lof[col] = pd.to_numeric(X_lof[col], errors="coerce")

X_lof = X_lof.fillna(X_lof.median())

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_lof)

sample_size = 100000
if len(X_scaled) > sample_size:
    sample_indices = np.random.RandomState(42).choice(len(X_scaled), sample_size, replace=False)
    X_sample = X_scaled[sample_indices]
else:
    sample_indices = np.arange(len(X_scaled))
    X_sample = X_scaled

lof_model = LocalOutlierFactor(n_neighbors=50, contamination=0.02, novelty=False, n_jobs=-1)
lof_predictions = lof_model.fit_predict(X_sample)
lof_scores = lof_model.negative_outlier_factor_

df_predictions["lof_anomaly"] = 0
df_predictions["lof_score"] = 0.0
df_predictions.loc[sample_indices, "lof_anomaly"] = (lof_predictions == -1).astype(int)
df_predictions.loc[sample_indices, "lof_score"] = lof_scores

joblib.dump(scaler, MODELS_PATH / "lof_scaler.pkl")
print("✅ Local Outlier Factor Pipeline Executed & Scaler Saved")

# ==============================================================================
# 6. COMBINED ENERGY RISK SCORE & REPORT GENERATION
# ==============================================================================

error_score = (df_predictions["absolute_error"] / df_predictions["absolute_error"].quantile(0.99)) * 100
df_predictions["error_risk_score"] = error_score.clip(0, 100)

df_predictions["statistical_risk_score"] = (df_predictions["residual_zscore"].abs() / 5 * 100).clip(0, 100)
df_predictions["isolation_risk_score"] = df_predictions["isolation_anomaly"] * 100
df_predictions["lof_risk_score"] = df_predictions["lof_anomaly"] * 100

df_predictions["energy_risk_score"] = (
      df_predictions["error_risk_score"] * 0.40
    + df_predictions["statistical_risk_score"] * 0.25
    + df_predictions["isolation_risk_score"] * 0.20
    + df_predictions["lof_risk_score"] * 0.15
).clip(0, 100)

def risk_category(score):
    if score < 20:
        return "Low Risk"
    elif score < 50:
        return "Medium Risk"
    elif score < 75:
        return "High Risk"
    else:
        return "Critical Risk"

df_predictions["energy_risk_category"] = df_predictions["energy_risk_score"].apply(risk_category)

# Building-Level Risk Aggregation
building_risk = (
    df_predictions.groupby("building_id")
    .agg(
        average_energy_risk=("energy_risk_score", "mean"),
        maximum_energy_risk=("energy_risk_score", "max"),
        anomaly_count=("isolation_anomaly", "sum"),
        total_records=("energy_risk_score", "count")
    )
    .reset_index()
)

building_risk["risk_rank"] = building_risk["average_energy_risk"].rank(ascending=False)
building_risk = building_risk.sort_values("average_energy_risk", ascending=False)

# Export Final Assets
risk_output = PROCESSED_PATH / "energy_risk_results.parquet"
building_output = REPORTS_PATH / "building_risk_ranking.csv"

OS_PROCESSED_PARQUET = PROCESSED_PATH / "prediction_results.parquet"
ISO_PARQUET = PROCESSED_PATH / "isolation_forest_results.parquet"
LOF_PARQUET = PROCESSED_PATH / "lof_results.parquet"

df_predictions.to_parquet(OS_PROCESSED_PARQUET, index=False)
df_predictions.to_parquet(ISO_PARQUET, index=False)
df_predictions.to_parquet(LOF_PARQUET, index=False)
df_predictions.to_parquet(risk_output, index=False)
building_risk.to_csv(building_output, index=False)

print("=" * 90)
print("PHASE-06 ANOMALY DETECTION ENGINE SUCCESSFULLY COMPLETED")
print("=" * 90)
print(f"Risk Dataset Saved To : {risk_output}")
print(f"Building Ranking Saved: {building_output}")
print("=" * 90)
