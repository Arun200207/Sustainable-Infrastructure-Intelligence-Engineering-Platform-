import pandas as pd



# ==============================================================================
# Load LOF Results
# ==============================================================================


if "df_predictions" not in globals():


    path = os.path.join(

        PROJECT_PATH,

        "processed",

        "lof_results.parquet"

    )


    df_predictions = pd.read_parquet(path)



print("\nDataset Loaded")

print(df_predictions.shape)



# ==============================================================================
# Normalize Error Score
# ==============================================================================


print("\nCreating Risk Components...")


# Residual Error Component

error_score = (

    df_predictions["absolute_error"]

    /

    df_predictions["absolute_error"].quantile(0.99)

) * 100



error_score = error_score.clip(

    0,

    100

)



df_predictions["error_risk_score"] = error_score



# ==============================================================================
# Statistical Risk
# ==============================================================================


df_predictions["statistical_risk_score"] = (

    df_predictions["residual_zscore"]

    .abs()

    /

    5

) * 100



df_predictions["statistical_risk_score"] = (

    df_predictions["statistical_risk_score"]

    .clip(0,100)

)



# ==============================================================================
# Isolation Forest Risk
# ==============================================================================


df_predictions["isolation_risk_score"] = (

    df_predictions["isolation_anomaly"]

    *100

)



# ==============================================================================
# LOF Risk
# ==============================================================================


df_predictions["lof_risk_score"] = (

    df_predictions["lof_anomaly"]

    *100

)



# ==============================================================================
# Combined Risk Score
# ==============================================================================


print("\nCalculating Final Energy Risk Score...")


df_predictions["energy_risk_score"] = (

      df_predictions["error_risk_score"] * 0.40

    + df_predictions["statistical_risk_score"] * 0.25

    + df_predictions["isolation_risk_score"] * 0.20

    + df_predictions["lof_risk_score"] * 0.15

)



df_predictions["energy_risk_score"] = (

    df_predictions["energy_risk_score"]

    .clip(0,100)

)



# ==============================================================================
# Risk Category
# ==============================================================================


def risk_category(score):

    if score < 20:

        return "Low Risk"

    elif score < 50:

        return "Medium Risk"

    elif score < 75:

        return "High Risk"

    else:

        return "Critical Risk"



df_predictions["energy_risk_category"] = (

    df_predictions["energy_risk_score"]

    .apply(risk_category)

)



# ==============================================================================
# Summary
# ==============================================================================


print("\nRisk Distribution")

print("-"*60)


print(

    df_predictions["energy_risk_category"]

    .value_counts()

)



print("\nAverage Risk Score:")

print(

    df_predictions["energy_risk_score"]

    .mean()

)



# ==============================================================================
# Building Level Risk Ranking
# ==============================================================================


