print(
    f"Minimum Residual : {df_predictions['residual'].min():.4f}"
)


print(
    f"Maximum Residual : {df_predictions['residual'].max():.4f}"
)



# ==============================================================================
# Residual Z-score
# ==============================================================================


print("\nCalculating Residual Z-score...")


df_predictions["residual_zscore"] = (

    (
        df_predictions["residual"]
        -
        residual_mean
    )

    /

    residual_std

)



print("Completed")



# ==============================================================================
# Statistical Thresholds
# ==============================================================================


print("\nCreating Statistical Anomaly Labels")


def anomaly_label(z):

    z = abs(z)

    if z < 2:

        return "Normal"

    elif z < 3:

        return "Moderate"

    elif z < 4:

        return "High"

    else:

        return "Critical"



df_predictions["statistical_anomaly_level"] = (

    df_predictions["residual_zscore"]

    .apply(anomaly_label)

)



# ==============================================================================
# Binary Anomaly Flag
# ==============================================================================


df_predictions["is_statistical_anomaly"] = (

    df_predictions["residual_zscore"]
    .abs()
    >= 3

).astype(int)



