def find_timestamp(df):

    candidates=[
        c for c in df.columns
        if "timestamp" in c.lower()
    ]

    if len(candidates)==0:
        raise Exception(
            "No timestamp found"
        )

    return candidates[0]
def process_resource(
    resource_name,
    filename
):

    print("\n===================")
    print("Processing:",resource_name)


    file_path=os.path.join(
        DATA_PATH,
        filename
    )


    # Load

    df=pd.read_csv(
        file_path
    )


    print(
        "Original Shape:",
        df.shape
    )


    # Timestamp

    timestamp_col=find_timestamp(df)


    df[timestamp_col]=pd.to_datetime(
        df[timestamp_col]
    )


    # Wide -> Long

    long_df=df.melt(

        id_vars=[
            timestamp_col
        ],

        var_name="building_id",

        value_name=resource_name

    )


    # Numeric optimisation

    long_df[resource_name]=pd.to_numeric(

        long_df[resource_name],

        errors="coerce",

        downcast="float"

    )


    # Category compression

    long_df["building_id"]=(
        long_df["building_id"]
        .astype("category")
    )


    # Save

    output=os.path.join(

        PROCESSED_PATH,

        f"{resource_name}.parquet"

    )


    long_df.to_parquet(

        output,

        compression="snappy"

    )


    print(
        "Processed:",
        long_df.shape
    )

    print(
        "Saved:",
        output
    )


    # Cleanup

    del df
    del long_df

    gc.collect()
for resource,file in resources.items():

    process_resource(
