    "artifacts": {
        "xai_dataset": str(xai_dataset_path),
        "xgboost_importance": str(XAI_ROOT / "xgboost_feature_importance.csv"),
        "global_shap": str(XAI_ROOT / "global_shap_importance.csv"),
        "local_summary": str(LOCAL_SUMMARY_PATH),
        "master_report": str(report_path),
    }
}

