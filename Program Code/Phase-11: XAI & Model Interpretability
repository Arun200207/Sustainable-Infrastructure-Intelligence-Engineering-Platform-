# Forecast Discrepancy Cross-Check
forecast_crosscheck = {
    "existing_forecast_artifact": str(
        PROJECT_ROOT / "processed" / "forecasting" / "xgboost_test_forecast.parquet"
    ),
    "existing_artifact_present": EXISTING_FORECAST is not None,
    "comparison_performed": False,
    "compared_rows": 0,
    "maximum_absolute_difference": None,
    "mean_absolute_difference": None,
    "interpretation": "No comparison performed."
}

if EXISTING_FORECAST is not None and "prediction" in EXISTING_FORECAST.columns:
    existing_prediction_values = (
        pd.to_numeric(EXISTING_FORECAST["prediction"], errors="coerce")
        .dropna()
        .to_numpy()
    )
    compare_count = min(len(existing_prediction_values), len(test_predictions))
    if compare_count > 0:
        differences = np.abs(
            existing_prediction_values[:compare_count] - test_predictions[:compare_count]
        )
        forecast_crosscheck = {
            "existing_forecast_artifact": str(
                PROJECT_ROOT / "processed" / "forecasting" / "xgboost_test_forecast.parquet"
            ),
            "existing_artifact_present": True,
            "comparison_performed": True,
            "compared_rows": int(compare_count),
            "maximum_absolute_difference": float(differences.max()),
            "mean_absolute_difference": float(differences.mean()),
            "interpretation": (
                "Existing forecast predictions differ from predictions generated using the "
                "reconstructed 13-feature model input. The existing forecast artifact was not overwritten."
            )
        }

overall_pass = all(validation.values())
validation["overall_status"] = "PASS" if overall_pass else "FAIL"

final_validation_report = {
    "phase": "Phase-11",
