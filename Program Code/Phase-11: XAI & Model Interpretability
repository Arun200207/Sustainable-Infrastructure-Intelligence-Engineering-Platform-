validation = {}

validation["project_root"] = PROJECT_ROOT.exists()
validation["model"] = MODEL_PATH.exists()
validation["training_dataset"] = TRAIN_PATH.exists()
validation["test_dataset"] = TEST_PATH.exists()

validation["model_feature_count"] = (len(MODEL_FEATURES) == 13)
validation["all_model_features_reconstructed"] = all(
    feature in ALL_FORECAST_DATA.columns for feature in MODEL_FEATURES
)
