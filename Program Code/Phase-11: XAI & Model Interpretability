validation["mae_finite"] = bool(np.isfinite(mae))
validation["rmse_finite"] = bool(np.isfinite(rmse))
validation["r2_finite"] = bool(np.isfinite(r2))

validation["xgboost_feature_importance"] = (len(feature_importance) == 13)
