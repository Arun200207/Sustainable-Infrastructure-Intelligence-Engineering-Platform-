print("Requested explanations:", LOCAL_SAMPLE_SIZE)
print("Individual explanation files:", len(individual_files))
print("Summary exists:", LOCAL_SUMMARY_PATH.exists())
print("\nSummary:\n", local_summary)

if len(individual_files) != LOCAL_SAMPLE_SIZE:
    raise RuntimeError("Not all local explanation files were created.")
if not LOCAL_SUMMARY_PATH.exists():
