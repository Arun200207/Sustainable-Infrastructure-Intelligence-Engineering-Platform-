def is_tree_explainable(model):

    model_name = type(model).__name__.lower()

    tree_keywords = [
        "xgb",
        "gradientboost",
        "randomforest",
        "extratrees",
        "decisiontree",
        "histgradient",
        "lgbm",
    ]

    if any(keyword in model_name for keyword in tree_keywords):
        return True

    if hasattr(model, "feature_importances_"):
        return True

    return False


