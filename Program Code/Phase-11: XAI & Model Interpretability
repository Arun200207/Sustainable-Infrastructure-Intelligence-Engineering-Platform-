def load_serialized_model(path):

    suffix = path.suffix.lower()

    try:
        if suffix in {".pkl", ".pickle"}:
            with open(path, "rb") as f:
                return pickle.load(f)

        if suffix == ".joblib":
            return joblib.load(path)

        if suffix in {".json", ".ubj", ".model"}:
            # XGBoost JSON/UBJ
            model = XGBModel()
            model.load_model(str(path))
            return model

    except Exception:
        return None

    return None


