# 10. REBUILD LOCAL EXPLANATIONS
# =================================0===========================

LOCAL_SAMPLE_SIZE = min(5, len(X_shap))
local_indices = np.linspace(0, len(X_shap) - 1, LOCAL_SAMPLE_SIZE, dtype=int)
local_results = []

for local_id, index in enumerate(local_indices, start=1):
    row = X_shap.iloc[index:index + 1].copy()

    prediction = float(PRIMARY_MODEL.predict(row)[0])
    values = np.asarray(shap_values.values[index])

    if len(values) != len(MODEL_FEATURES):
        raise RuntimeError("Local SHAP feature count mismatch.")

    local_df = pd.DataFrame({
        "feature": MODEL_FEATURES,
        "feature_value": row.iloc[0][MODEL_FEATURES].to_numpy(),
        "shap_value": values,
        "absolute_shap": np.abs(values)
    })

    local_df = (
        local_df
        .sort_values("absolute_shap", ascending=False)
        .reset_index(drop=True)
    )
    local_df["rank"] = local_df.index + 1

    output_path = XAI_ROOT / f"local_explanation_{local_id}.csv"
    local_df.to_csv(output_path, index=False)

    top_row = local_df.iloc[0]
    local_results.append({
        "sample": int(local_id),
        "row_index": int(index),
        "prediction": prediction,
        "top_feature": str(top_row["feature"]),
        "top_shap_value": float(top_row["shap_value"]),
        "top_absolute_shap": float(top_row["absolute_shap"])
    })

local_summary = pd.DataFrame(local_results)
LOCAL_SUMMARY_PATH = XAI_ROOT / "local_explanation_summary.csv"
local_summary.to_csv(LOCAL_SUMMARY_PATH, index=False)

# Validation of local files
individual_files = [
    path for path in XAI_ROOT.glob("local_explanation_*.csv")
    if path.name != "local_explanation_summary.csv"
]

