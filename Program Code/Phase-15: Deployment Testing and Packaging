# ============================================================
# PHASE-15 — SUSTAINABLE INFRASTRUCTURE INTELLIGENCE PLATFORM
# DEPLOYMENT, FASTAPI API, PACKAGING, & VALIDATION PIPELINE
# ============================================================

import json
import logging
import sys
from pathlib import Path

import numpy as np
import pandas as pd
from fastapi import FastAPI
from fastapi.testclient import TestClient
from pydantic import BaseModel
import joblib

# ------------------------------------------------------------
# 1. CONFIGURATION & LOGGING SETUP
# ------------------------------------------------------------

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s"
)
logger = logging.getLogger("Phase15Pipeline")

PROJECT_ROOT = Path("/content/drive/MyDrive/GitHub_Project_01")
if not PROJECT_ROOT.exists():
    PROJECT_ROOT = Path.cwd()

MODEL_PATH = PROJECT_ROOT / "models" / "forecasting" / "xgboost_forecast_model.pkl"
XAI_PATH = PROJECT_ROOT / "processed" / "phase11_xai" / "xai_test_feature_dataset.parquet"
PHASE14_PATH = PROJECT_ROOT / "processed" / "phase14_inference" / "phase14_inference_predictions.parquet"

API_DIR = PROJECT_ROOT / "api"
API_PATH = API_DIR / "main.py"
REPORT_DIR = PROJECT_ROOT / "reports" / "phase15_deployment"
VALIDATION_PATH = REPORT_DIR / "phase15_final_validation.json"

FEATURES = [
    "year",
    "month",
    "day",
    "weekday",
    "week_of_year",
    "is_weekend",
    "lag_1",
    "lag_7",
    "lag_14",
    "lag_30",
    "rolling_7",
    "rolling_30",
    "rolling_std_30"
]


# ------------------------------------------------------------
# 2. FASTAPI APPLICATION FACTORY / DEFINITION
# ------------------------------------------------------------

def create_fastapi_app() -> FastAPI:
    """Initializes and configures the FastAPI application."""
    app = FastAPI(
        title="Sustainable Infrastructure Intelligence API",
        version="1.0.0"
    )

    if not MODEL_PATH.exists():
        raise FileNotFoundError(f"Model artifact not found at {MODEL_PATH}")

    model = joblib.load(MODEL_PATH)

    class PredictionRequest(BaseModel):
        year: int
        month: int
        day: int
        weekday: int
        week_of_year: int
        is_weekend: int
        lag_1: float
        lag_7: float
        lag_14: float
        lag_30: float
        rolling_7: float
        rolling_30: float
        rolling_std_30: float

    @app.get("/")
    def root():
        return {
            "project": "Sustainable Infrastructure Intelligence Platform",
            "status": "online",
            "service": "energy forecasting API"
        }

    @app.get("/health")
    def health():
        return {
            "status": "healthy",
            "model": "XGBRegressor",
            "features": len(FEATURES)
        }

    @app.post("/predict")
    def predict(request: PredictionRequest):
        values = [getattr(request, feature) for feature in FEATURES]
        X = np.array([values], dtype=float)
        prediction = float(model.predict(X)[0])
        return {
            "predicted_energy": prediction,
            "unit": "kWh"
        }

    return app


# ------------------------------------------------------------
# 3. MAIN PIPELINE EXECUTION
# ------------------------------------------------------------

def main() -> None:
    logger.info("=" * 60)
    logger.info("PHASE-15 — DEPLOYMENT, PACKAGING & VALIDATION PIPELINE")
    logger.info("=" * 60)

    # Step 1: Project & Artifact Verification
    logger.info(f"Project root: {PROJECT_ROOT}")
    assert PROJECT_ROOT.exists(), f"Project root missing: {PROJECT_ROOT}"
    assert MODEL_PATH.exists(), f"XGBoost model missing: {MODEL_PATH}"
    assert XAI_PATH.exists(), f"XAI dataset missing: {XAI_PATH}"
    assert PHASE14_PATH.exists(), f"Phase-14 inference missing: {PHASE14_PATH}"
    logger.info("Project verification: PASS")

    # Step 2: Setup Deployment Structure
    API_DIR.mkdir(parents=True, exist_ok=True)
    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    (API_DIR / "__init__.py").touch()
    logger.info("Deployment directories initialized successfully.")

    # Step 3: Write FastAPI Source Code
    api_code = '''from pathlib import Path
import joblib
import numpy as np
from fastapi import FastAPI
from pydantic import BaseModel

PROJECT_ROOT = Path("/content/drive/MyDrive/GitHub_Project_01")
if not PROJECT_ROOT.exists():
    PROJECT_ROOT = Path.cwd()

MODEL_PATH = PROJECT_ROOT / "models/forecasting/xgboost_forecast_model.pkl"

FEATURES = [
    "year", "month", "day", "weekday", "week_of_year", "is_weekend",
    "lag_1", "lag_7", "lag_14", "lag_30",
    "rolling_7", "rolling_30", "rolling_std_30"
]

model = joblib.load(MODEL_PATH)

app = FastAPI(
    title="Sustainable Infrastructure Intelligence API",
    version="1.0.0"
)

class PredictionRequest(BaseModel):
    year: int
    month: int
    day: int
    weekday: int
    week_of_year: int
    is_weekend: int
    lag_1: float
    lag_7: float
    lag_14: float
    lag_30: float
    rolling_7: float
    rolling_30: float
    rolling_std_30: float

@app.get("/")
def root():
    return {
        "project": "Sustainable Infrastructure Intelligence Platform",
        "status": "online",
        "service": "energy forecasting API"
    }

@app.get("/health")
def health():
    return {
        "status": "healthy",
        "model": "XGBRegressor",
        "features": len(FEATURES)
    }

@app.post("/predict")
def predict(request: PredictionRequest):
    values = [getattr(request, feature) for feature in FEATURES]
    X = np.array([values], dtype=float)
    prediction = float(model.predict(X)[0])
    return {
        "predicted_energy": prediction,
        "unit": "kWh"
    }
'''
    API_PATH.write_text(api_code)
    assert API_PATH.exists()
    logger.info(f"FastAPI application written to: {API_PATH}")

    # Step 4: Instantiate Test Client & Run Health Check
    sys.path.insert(0, str(PROJECT_ROOT))
    app = create_fastapi_app()
    client = TestClient(app)

    health_response = client.get("/health")
    assert health_response.status_code == 200
    logger.info(f"API Health Check Response: {health_response.json()}")

    # Step 5: Real Inference Test via TestClient
    xai_df = pd.read_parquet(XAI_PATH)
    row = xai_df.iloc[0]

    payload = {feature: float(row[feature]) for feature in FEATURES}
    for feature in ["year", "month", "day", "weekday", "week_of_year", "is_weekend"]:
        payload[feature] = int(payload[feature])

    response = client.post("/predict", json=payload)
    assert response.status_code == 200
    result = response.json()
    prediction = result["predicted_energy"]
    assert np.isfinite(prediction)
    logger.info(f"API Prediction Test Passed. Prediction: {prediction} {result['unit']}")

    # Step 6: Phase-14 ↔ API Cross-Validation
    phase14_df = pd.read_parquet(PHASE14_PATH)
    expected_prediction = float(phase14_df.iloc[0]["prediction"])
    difference = abs(prediction - expected_prediction)

    logger.info(f"API Prediction: {prediction} | Phase-14 Prediction: {expected_prediction} | Diff: {difference}")
    assert np.isfinite(expected_prediction)
    assert difference < 1e-3
    logger.info("Phase-14 ↔ API Cross-Validation: PASS")

    # Step 7: Input Validation Test (Expect 422 Unprocessable Entity)
    bad_response = client.post("/predict", json={})
    assert bad_response.status_code == 422
    logger.info("API Input Validation Gate: PASS")

    # Step 8: Generate Deployment Packaging Files (Requirements, Dockerfile, Gitignore, README)
    requirements = "fastapi\nuvicorn\npydantic\numpy\njoblib\nscikit-learn\nxgboost\npyarrow\n"
    (PROJECT_ROOT / "requirements.txt").write_text(requirements)

    dockerfile = """FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY api ./api
COPY models ./models
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
"""
    (PROJECT_ROOT / "Dockerfile").write_text(dockerfile)

    gitignore = """__pycache__/
*.pyc
.ipynb_checkpoints/
.env
*.log
mlflow.db
mlruns/
.DS_Store
"""
    (PROJECT_ROOT / ".gitignore").write_text(gitignore)

    readme = """# Sustainable Infrastructure Intelligence Platform

An end-to-end ML platform for energy forecasting, sustainability
intelligence, explainable AI, RAG-based assistance, automated reporting,
interactive dashboards, and production-style inference.

## Architecture
Data → Sustainability Intelligence → Forecasting → XAI → RAG → Reporting → Streamlit Dashboard → MLflow → FastAPI Inference API

## MLOps & Deployment
- MLflow experiment tracking & SQLite backend
- FastAPI prediction endpoint with schema validation
- Container-ready via Docker
"""
    (PROJECT_ROOT / "README.md").write_text(readme)

    logger.info("Deployment configuration files (requirements, Dockerfile, .gitignore, README) generated.")

    # Step 9: Save Validation Report
    validation_payload = {
        "phase": "Phase-15",
        "status": "PASS",
        "api": {
            "file_exists": API_PATH.exists(),
            "health_status": health_response.status_code,
            "prediction_status": response.status_code,
            "invalid_request_status": bad_response.status_code
        },
        "prediction": {
            "finite": bool(np.isfinite(prediction)),
            "phase14_match": bool(difference < 1e-3),
            "absolute_difference": float(difference)
        },
        "packaging": {
            "requirements": (PROJECT_ROOT / "requirements.txt").exists(),
            "dockerfile": (PROJECT_ROOT / "Dockerfile").exists(),
            "gitignore": (PROJECT_ROOT / ".gitignore").exists(),
            "readme": (PROJECT_ROOT / "README.md").exists()
        }
    }

    with open(VALIDATION_PATH, "w") as f:
        json.dump(validation_payload, f, indent=2)

    assert VALIDATION_PATH.exists()
    logger.info(f"Validation report saved to: {VALIDATION_PATH}")

    # Step 10: Final Completion Gate
    final_pass = (
        API_PATH.exists()
        and health_response.status_code == 200
        and response.status_code == 200
        and bad_response.status_code == 422
        and np.isfinite(prediction)
        and difference < 1e-3
        and (PROJECT_ROOT / "requirements.txt").exists()
        and (PROJECT_ROOT / "Dockerfile").exists()
        and (PROJECT_ROOT / ".gitignore").exists()
        and (PROJECT_ROOT / "README.md").exists()
        and VALIDATION_PATH.exists()
    )

    logger.info("=" * 60)
    if final_pass:
        logger.info("🟢 PHASE-15 COMPLETE — PASS")
        logger.info("✓ FastAPI inference API created")
        logger.info("✓ Health endpoint verified")
        logger.info("✓ Prediction endpoint & schema validation checked")
        logger.info("✓ Phase-14 ↔ API consistency cross-validated")
        logger.info("✓ GitHub packaging & Docker deployment setup complete")
        logger.info("✓ Machine-readable validation report generated")
    else:
        logger.info("🔴 PHASE-15 FAIL")
    logger.info("=" * 60)


if __name__ == "__main__":
    main()
