api_code = r'''
from pathlib import Path

import joblib
import numpy as np

from fastapi import FastAPI
from pydantic import BaseModel


PROJECT_ROOT = Path(
    "/content/drive/MyDrive/GitHub_Project_01"
)

MODEL_PATH = (
    PROJECT_ROOT /
    "models/forecasting/xgboost_forecast_model.pkl"
)

FEATURES = [
    "year",
    "month",
    "day",
    "weekday",
    "week_of_year",
    "is_weekend",
    "lag_1",
    "lag_7",
    "lag_14",
    "lag_30",
    "rolling_7",
    "rolling_30",
    "rolling_std_30"
]

model = joblib.load(MODEL_PATH)

app = FastAPI(
    title="Sustainable Infrastructure Intelligence API",
    version="1.0.0"
)


class PredictionRequest(BaseModel):

    year: int
    month: int
    day: int
    weekday: int
    week_of_year: int
    is_weekend: int

    lag_1: float
    lag_7: float
    lag_14: float
    lag_30: float

    rolling_7: float
    rolling_30: float
    rolling_std_30: float


@app.get("/")
def root():

    return {
        "project":
            "Sustainable Infrastructure Intelligence Platform",
        "status": "online",
        "service": "energy forecasting API"
    }


@app.get("/health")
def health():

    return {
        "status": "healthy",
        "model": "XGBRegressor",
        "features": len(FEATURES)
    }


@app.post("/predict")
def predict(request: PredictionRequest):

    values = [
        getattr(request, feature)
        for feature in FEATURES
    ]

    X = np.array(
        [values],
        dtype=float
    )

    prediction = float(
        model.predict(X)[0]
    )

    return {
        "predicted_energy": prediction,
        "unit": "kWh"
    }
'''


API_PATH = API_DIR / "main.py"

API_PATH.write_text(api_code)

assert API_PATH.exists()

print("=" * 60)
print("FASTAPI APPLICATION")
print("=" * 60)

print(API_PATH)
