import pandas as pd

xai_df = pd.read_parquet(
    XAI_PATH
)

FEATURES = [
    "year",
    "month",
    "day",
    "weekday",
    "week_of_year",
    "is_weekend",
    "lag_1",
    "lag_7",
    "lag_14",
    "lag_30",
    "rolling_7",
    "rolling_30",
    "rolling_std_30"
]

row = xai_df.iloc[0]

payload = {
    feature: float(row[feature])
    for feature in FEATURES
}

# Convert integer-like fields
for feature in [
    "year",
    "month",
    "day",
    "weekday",
    "week_of_year",
    "is_weekend"
]:
    payload[feature] = int(payload[feature])


response = client.post(
    "/predict",
    json=payload
)

assert response.status_code == 200

result = response.json()

prediction = result[
    "predicted_energy"
]

assert np.isfinite(prediction)

print("=" * 60)
print("API PREDICTION TEST")
print("=" * 60)

print("Status:", response.status_code)
print("Prediction:", prediction)
print("Unit:", result["unit"])

