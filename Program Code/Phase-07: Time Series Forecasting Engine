print("\nCreating XGBoost Forecast Features...")



df_xgb = forecast_df.copy()



# Sort by date

df_xgb = (

    df_xgb

    .sort_values(

        "datetime"

    )

)



# ------------------------------------------------
# Calendar Features
# ------------------------------------------------


df_xgb["year"] = (

    df_xgb["datetime"]

    .dt.year

)


df_xgb["month"] = (

    df_xgb["datetime"]

    .dt.month

)


df_xgb["day"] = (

    df_xgb["datetime"]

    .dt.day

)


df_xgb["weekday"] = (

    df_xgb["datetime"]

    .dt.weekday

)



df_xgb["week_of_year"] = (

    df_xgb["datetime"]

    .dt.isocalendar()

    .week

    .astype(int)

)



df_xgb["is_weekend"] = (

    df_xgb["weekday"]

    >= 5

).astype(int)



# ------------------------------------------------
# Lag Features
# ------------------------------------------------


print(
    "Creating lag features..."
)



df_xgb["lag_1"] = (

    df_xgb["target_energy"]

    .shift(1)

)



df_xgb["lag_7"] = (

    df_xgb["target_energy"]

    .shift(7)

)



df_xgb["lag_14"] = (

    df_xgb["target_energy"]

    .shift(14)

)



df_xgb["lag_30"] = (

    df_xgb["target_energy"]

    .shift(30)

)



# ------------------------------------------------
# Rolling Features
# ------------------------------------------------


print(
    "Creating rolling features..."
)



df_xgb["rolling_7"] = (

    df_xgb["target_energy"]

    .rolling(7)

    .mean()

)



df_xgb["rolling_30"] = (

    df_xgb["target_energy"]

    .rolling(30)

    .mean()

)



df_xgb["rolling_std_30"] = (

    df_xgb["target_energy"]

    .rolling(30)

    .std()

)



# Remove missing rows

df_xgb.dropna(

    inplace=True

)



print(

    "Feature Dataset:",

    df_xgb.shape

)



# ================================================================
