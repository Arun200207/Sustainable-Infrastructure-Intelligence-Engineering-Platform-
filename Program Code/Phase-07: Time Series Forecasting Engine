# ================================================================
# 5. EXACT XGBoost Feature Generator
# ================================================================


def create_xgb_features(df):


    data = df.copy()


    data = (

        data

        .sort_values(

            "datetime"

        )

    )


    # Calendar Features

    data["year"] = (

        data["datetime"]

        .dt.year

    )


    data["month"] = (

        data["datetime"]

        .dt.month

    )


    data["day"] = (

        data["datetime"]

        .dt.day

    )


    data["weekday"] = (

        data["datetime"]

        .dt.weekday

    )



    data["week_of_year"] = (

        data["datetime"]

        .dt.isocalendar()

        .week

        .astype(int)

    )



    data["is_weekend"] = (

        data["weekday"]

        >=5

    ).astype(int)



    # EXACT TRAINING LAGS


    data["lag_1"] = (

        data["target_energy"]

        .shift(1)

    )


    data["lag_7"] = (

        data["target_energy"]

        .shift(7)

    )


    data["lag_14"] = (

        data["target_energy"]

        .shift(14)

    )


    data["lag_30"] = (

        data["target_energy"]

        .shift(30)

    )



    # EXACT TRAINING ROLLING FEATURES


    data["rolling_7"] = (

        data["target_energy"]

        .rolling(7)

        .mean()

    )



    data["rolling_30"] = (

        data["target_energy"]

        .rolling(30)

        .mean()

    )



    data["rolling_std_30"] = (

        data["target_energy"]

        .rolling(30)

        .std()

    )



    return data



# ================================================================
# 6. Future Forecast Generator
# ================================================================


def generate_future_forecast(

    history,

    days

):


    future_dates = pd.date_range(

        start=

        history["datetime"].max()

        +

        pd.Timedelta(days=1),


        periods=days,

        freq="D"

    )



    future = pd.DataFrame(

        {

            "datetime":

            future_dates,


            "target_energy":

            np.nan

        }

    )



    combined = pd.concat(

        [

            history,

            future

        ],

        ignore_index=True

    )



    feature_data = create_xgb_features(

        combined

    )



    future_rows = (

        feature_data

        .tail(days)

        .copy()

    )



    # Use previous values for recursive forecasting


    future_rows = (

        future_rows

        .ffill()

    )



    required_features = [

        "year",

        "month",

        "day",

        "weekday",

        "week_of_year",

        "is_weekend",

        "lag_1",

        "lag_7",

        "lag_14",

        "lag_30",

        "rolling_7",

        "rolling_30",

        "rolling_std_30"

    ]



    X_future = future_rows[

        required_features

    ]



    predictions = model.predict(

        X_future

    )



    result = pd.DataFrame(

        {

            "datetime":

            future_dates,


            "predicted_energy":

            predictions

        }

    )


    return result



