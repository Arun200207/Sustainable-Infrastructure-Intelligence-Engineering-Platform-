# 9. Time-Based Train Validation Test Split
# ================================================================


print("\nCreating Time-Based Splits...")


min_date = forecast_ready["datetime"].min()

max_date = forecast_ready["datetime"].max()



print(
    "Dataset Range:"
)

print(
    min_date,
    "to",
    max_date
)



# 70 / 15 / 15 split


total_days = (

    max_date -

    min_date

).days



train_end = (

    min_date

    +

    pd.Timedelta(

        days=int(total_days*0.70)

    )

)



validation_end = (

    min_date

    +

    pd.Timedelta(

        days=int(total_days*0.85)

    )

)



train_df = forecast_ready[

    forecast_ready["datetime"]

    <= train_end

]



validation_df = forecast_ready[

    (

        forecast_ready["datetime"]

        > train_end

    )

    &

    (

        forecast_ready["datetime"]

        <= validation_end

    )

]



test_df = forecast_ready[

    forecast_ready["datetime"]

    > validation_end

]



print()

print(
    "Training:",
    train_df.shape
)


print(
    "Validation:",
    validation_df.shape
)


print(
    "Testing:",
    test_df.shape
