train_end = (

    pd.Timestamp(

        "2016-12-31"

    )

)


validation_end = (

    pd.Timestamp(

        "2017-06-30"

    )

)



train = df_xgb[

    df_xgb.datetime <= train_end

]



validation = df_xgb[

    (

        df_xgb.datetime >

        train_end

    )

    &

    (

        df_xgb.datetime <=

        validation_end

    )

]



test = df_xgb[

