from statsmodels.tsa.stattools import adfuller

from statsmodels.tsa.seasonal import seasonal_decompose

import matplotlib.pyplot as plt

import seaborn as sns



# ================================================================
# 2. Verify Forecast Dataset
# ================================================================


if "campus_df" not in globals():

    campus_df = pd.read_parquet(

        FORECAST_DIR /

        "campus_timeseries.parquet"

    )


print(
    "Campus Dataset Loaded"
)


print(
    campus_df.shape
)



# ================================================================
# 3. Prepare Time Series Index
# ================================================================


ts_df = (

    campus_df

    .copy()

)


ts_df = (

    ts_df

    .sort_values(
        "datetime"
    )

)



ts_df = (

    ts_df

    .set_index(
        "datetime"
    )

)



energy_series = (

    ts_df["daily_electricity"]

)



print()

print(
    energy_series.head()
)



# ================================================================
# 4. Rolling Statistics
# ================================================================


print("\nCalculating Rolling Statistics...")


rolling_window = 30


rolling_mean = (

    energy_series

    .rolling(
        rolling_window
    )

    .mean()

)



rolling_std = (

    energy_series

    .rolling(
        rolling_window
    )

    .std()

)



rolling_report = pd.DataFrame(

    {

        "energy":

        energy_series,


        "rolling_mean_30":

        rolling_mean,


        "rolling_std_30":

        rolling_std

    }

)



rolling_report.head()



# Save rolling statistics


rolling_report.to_parquet(

    FORECAST_DIR /

    "rolling_statistics.parquet"

)



print(
    "Rolling statistics saved"
)



# ================================================================
# 5. Augmented Dickey Fuller Test
# ================================================================


print("\nRunning ADF Stationarity Test...")


adf_result = adfuller(

    energy_series.dropna()

)



adf_report = pd.DataFrame(

    {

        "Metric":

        [

            "ADF Statistic",

            "p-value",

            "Used Lags",

            "Observations"

        ],


        "Value":

        [

            adf_result[0],

            adf_result[1],

            adf_result[2],

            adf_result[3]

        ]

    }

)



print(
    adf_report
)



# Interpretation


if adf_result[1] <= 0.05:


    stationarity_status = "Stationary"


else:


    stationarity_status = "Non-Stationary"



print()

print(
    "Stationarity Status:",
    stationarity_status
)



adf_report.to_csv(

    REPORT_DIR /

    "stationarity_report.csv",

    index=False

)



# ================================================================
# 6. Seasonal Decomposition
# ================================================================


print("\nPerforming Seasonal Decomposition...")


# Daily energy:
# yearly seasonality = 365


decomposition = seasonal_decompose(

    energy_series,

    model="additive",

    period=365,

    extrapolate_trend="freq"

)



seasonal_df = pd.DataFrame(

    {

        "observed":

        decomposition.observed,


        "trend":

        decomposition.trend,


        "seasonal":

        decomposition.seasonal,


        "residual":

        decomposition.resid

    }

)



seasonal_df.to_parquet(

    FORECAST_DIR /

    "seasonal_decomposition.parquet"

)



print(
    "Seasonal decomposition saved"
)



