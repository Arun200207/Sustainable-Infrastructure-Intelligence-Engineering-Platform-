# ================================================================
# 1. Project Path Validation & Setup
# ================================================================

if "PROJECT_ROOT" not in globals():
    from pathlib import Path
    # Fallback path definition if run standalone
    PROJECT_ROOT = Path("/content/drive/MyDrive/GitHub_Project_01")

FORECAST_DIR = PROJECT_ROOT / "processed" / "forecasting"
MODEL_DIR = PROJECT_ROOT / "models"
REPORT_DIR = PROJECT_ROOT / "reports"
PLOT_DIR = PROJECT_ROOT / "plots" / "forecasting"

for directory in [FORECAST_DIR, MODEL_DIR / "forecasting", REPORT_DIR, PLOT_DIR, REPORT_DIR / "phase07"]:
    directory.mkdir(parents=True, exist_ok=True)

print("Project directories verified and secured.")


# ================================================================
# 2. Load Forecast Dataset
# ================================================================

forecast_file = FORECAST_DIR / "final_forecast_dataset.parquet"
if not forecast_file.exists():
    raise FileNotFoundError(f"Required dataset missing at: {forecast_file}")

forecast_df = pd.read_parquet(forecast_file).sort_values("datetime")
print(f"Dataset Loaded Successfully. Shape: {forecast_df.shape}")


# ================================================================
# 3. Advanced Feature Engineering (Calendar, Lags, Rolling)
# ================================================================

print("\nExecuting Feature Engineering Pipeline...")
df_ml = forecast_df.copy()

# Calendar Features
df_ml["year"] = df_ml["datetime"].dt.year
df_ml["month"] = df_ml["datetime"].dt.month
df_ml["day"] = df_ml["datetime"].dt.day
df_ml["weekday"] = df_ml["datetime"].dt.weekday
df_ml["quarter"] = df_ml["datetime"].dt.quarter
df_ml["week_of_year"] = df_ml["datetime"].dt.isocalendar().week.astype(int)
df_ml["is_weekend"] = (df_ml["weekday"] >= 5).astype(int)

# Lag Features
for lag in [1, 7, 14, 30, 60]:
    df_ml[f"lag_{lag}"] = df_ml["target_energy"].shift(lag)

# Rolling Statistics
for window in [7, 14, 30, 60]:
    df_ml[f"rolling_mean_{window}"] = df_ml["target_energy"].rolling(window).mean()
    df_ml[f"rolling_std_{window}"] = df_ml["target_energy"].rolling(window).std()

df_ml.dropna(inplace=True)
print(f"Engineered Feature Dataset Shape: {df_ml.shape}")


# ================================================================
# 4. Chronological Time-Based Data Split
# ================================================================

train_end = pd.Timestamp("2016-12-31")
validation_end = pd.Timestamp("2017-06-30")

train = df_ml[df_ml.datetime <= train_end]
validation = df_ml[(df_ml.datetime > train_end) & (df_ml.datetime <= validation_end)]
test = df_ml[df_ml.datetime > validation_end]

print(f"Train Split: {train.shape}")
print(f"Validation Split: {validation.shape}")
print(f"Test Split: {test.shape}")

target = "target_energy"
drop_columns = ["datetime", target]
features = [col for col in train.columns if col not in drop_columns]

X_train, y_train = train[features], train[target]
X_validation, y_validation = validation[features], validation[target]
X_test, y_test = test[features], test[target]


# ================================================================
# 5. LightGBM Model Training & Evaluation
# ================================================================

print("\nTraining LightGBM Forecasting Model...")
lgbm_model = LGBMRegressor(
    n_estimators=600,
    learning_rate=0.05,
    num_leaves=64,
    max_depth=-1,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
    objective="regression",
    metric="rmse"
)

lgbm_model.fit(
    X_train, y_train,
    eval_set=[(X_validation, y_validation)]
)

val_preds = lgbm_model.predict(X_validation)

# Evaluation Metrics Calculation
mae = mean_absolute_error(y_validation, val_preds)
rmse = np.sqrt(mean_squared_error(y_validation, val_preds))
mape = np.mean(np.abs((y_validation.values - val_preds) / y_validation.values)) * 100
r2 = r2_score(y_validation, val_preds)

lgbm_results = pd.DataFrame({
    "Model": ["LightGBM Forecast"],
    "MAE": [mae],
    "RMSE": [rmse],
    "MAPE": [mape],
    "R2": [r2]
})

lgbm_results.to_csv(REPORT_DIR / "lightgbm_forecast_results.csv", index=False)

# Save validation predictions
pd.DataFrame({
    "datetime": validation["datetime"],
    "actual": y_validation.values,
    "prediction": val_preds
}).to_parquet(FORECAST_DIR / "lightgbm_validation_forecast.parquet", index=False)

# Save LightGBM Model
with open(MODEL_DIR / "lightgbm_forecast_model.pkl", "wb") as f:
    pickle.dump(lgbm_model, f)

print("LightGBM Training and Evaluation Complete.")


# ================================================================
# 6. Model Evaluation & Leaderboard Aggregation
# ================================================================

print("\nAggregating Model Comparison Leaderboard...")
result_files = {
    "ARIMA": REPORT_DIR / "arima_results.csv",
    "Prophet": REPORT_DIR / "prophet_results.csv",
    "XGBoost": REPORT_DIR / "xgboost_forecast_results.csv",
    "LightGBM": REPORT_DIR / "lightgbm_forecast_results.csv"
}

results = []
for model_name, file_path in result_files.items():
    if file_path.exists():
        df_res = pd.read_csv(file_path)
        results.append(df_res)

if results:
    model_comparison = pd.concat(results, ignore_index=True)
    model_comparison["Model"] = model_comparison["Model"].str.replace(" Forecast", "", regex=False)
    model_comparison["R2"] = model_comparison["R2"].fillna(0)

    # Normalize metrics for scoring
    for metric in ["MAE", "RMSE", "MAPE"]:
        max_val = model_comparison[metric].max()
        model_comparison[f"{metric}_score"] = 1 - (model_comparison[metric] / max_val)

    max_r2 = model_comparison["R2"].max()
    model_comparison["R2_score"] = (model_comparison["R2"] / max_r2) if max_r2 > 0 else 0

    model_comparison["forecast_score"] = (
        model_comparison["MAE_score"] * 0.35 +
        model_comparison["RMSE_score"] * 0.35 +
        model_comparison["MAPE_score"] * 0.20 +
        model_comparison["R2_score"] * 0.10
    )

    ranking = model_comparison.sort_values("forecast_score", ascending=False).reset_index(drop=True)
    ranking["Rank"] = ranking.index + 1

    ranking.to_csv(REPORT_DIR / "forecasting_model_ranking.csv", index=False)
    
    best_model = ranking.iloc[0]["Model"]
    best_score = ranking.iloc[0]["forecast_score"]

    with open(REPORT_DIR / "best_forecasting_model.txt", "w") as f:
        f.write(f"Best Model: {best_model}\nScore: {best_score}\n")

    print(f"Leaderboard Established. Best Model Selected: {best_model}")


# ================================================================
# 7. Future Forecast Generation (Horizon: 7, 30, 90 Days)
# ================================================================

print("\nGenerating Recursive Future Forecasts...")

def generate_future_forecast(history_df, days_ahead, model_obj):
    future_dates = pd.date_range(
        start=history_df["datetime"].max() + pd.Timedelta(days=1),
        periods=days_ahead,
        freq="D"
    )
    future_df = pd.DataFrame({"datetime": future_dates, "target_energy": np.nan})
    combined = pd.concat([history_df, future_df], ignore_index=True).sort_values("datetime")

    # Recompute features on combined history + future
    combined["year"] = combined["datetime"].dt.year
    combined["month"] = combined["datetime"].dt.month
    combined["day"] = combined["datetime"].dt.day
    combined["weekday"] = combined["datetime"].dt.weekday
    combined["week_of_year"] = combined["datetime"].dt.isocalendar().week.astype(int)
    combined["is_weekend"] = (combined["weekday"] >= 5).astype(int)

    for lag in [1, 7, 14, 30, 60]:
        combined[f"lag_{lag}"] = combined["target_energy"].shift(lag)
    for window in [7, 14, 30, 60]:
        combined[f"rolling_mean_{window}"] = combined["target_energy"].rolling(window).mean()
        combined[f"rolling_std_{window}"] = combined["target_energy"].rolling(window).std()

    future_rows = combined.tail(days_ahead).copy().ffill()
    
    # Align features
    X_fut = future_rows[features]
    preds = model_obj.predict(X_fut)

    return pd.DataFrame({"datetime": future_dates, "predicted_energy": preds})

# Load Best Production Model (Defaulting to XGBoost or LightGBM based on registry)
best_model_path = MODEL_DIR / f"{best_model.lower()}_forecast_model.pkl"
if not best_model_path.exists():
    best_model_path = MODEL_DIR / "xgboost_forecast_model.pkl"

with open(best_model_path, "rb") as f:
    production_model = pickle.load(f)

for horizon in [7, 30, 90]:
    fut_res = generate_future_forecast(forecast_df, horizon, production_model)
    fut_res.to_parquet(FORECAST_DIR / f"future_forecast_{horizon}_days.parquet", index=False)

print("Future Forecast Horizons (7, 30, 90 Days) Generated & Saved.")


