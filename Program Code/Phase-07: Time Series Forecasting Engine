        .quantile(0.25)

    )


    q3 = (

        data[energy_column]

        .quantile(0.75)

    )


    iqr = q3 - q1


    lower = q1 - (1.5 * iqr)


    upper = q3 + (1.5 * iqr)


    outliers = (

        (data[energy_column] < lower)

        |

        (data[energy_column] > upper)

    ).sum()



    print()

    print(
        name
    )


    print(

        "Outliers:",

        outliers

    )



    outlier_results.append(

        {

            "dataset":

            name,


            "outliers":

            outliers,


            "lower_limit":

            lower,


