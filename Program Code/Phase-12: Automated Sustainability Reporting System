    with open(PHASE12_JSON, "r", encoding="utf-8") as f:
        phase12 = json.load(f)

    print("\nPhase-12 top-level sections:")
    if isinstance(phase12, dict):
        print(list(phase12.keys()))

    # Search recursively for recommendation-related keys
    found_phase12 = []

    def search_keys(obj, path="root"):
        if isinstance(obj, dict):
            for key, value in obj.items():

                if any(
                    term in key.lower()
                    for term in [
                        "recommend",
                        "intervention",
                        "action",
                        "priority"
                    ]
                ):
                    found_phase12.append((path, key, value))

                search_keys(value, f"{path}.{key}")

        elif isinstance(obj, list):
            for i, value in enumerate(obj):
                search_keys(value, f"{path}[{i}]")

    search_keys(phase12)

    print("\nRecommendation-related Phase-12 fields found:")
    print(len(found_phase12))

    for path, key, value in found_phase12[:20]:
        print("\nPATH:", path)
        print("KEY :", key)

        if isinstance(value, list):
            print("COUNT:", len(value))
            print("SAMPLE:", value[:3])
        else:
            print("VALUE:", value)

