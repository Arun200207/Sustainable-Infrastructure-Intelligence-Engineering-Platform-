def generate_grounded_recommendation(row):
    recommendations = []

    carbon_score = row.get("carbon_score")
    cost_score = row.get("cost_score")

    if pd.notna(carbon_score):
        if carbon_score < 50:
            recommendations.append(
                "Prioritize carbon-reduction interventions."
            )
        elif carbon_score < 75:
            recommendations.append(
                "Review carbon-intensive energy consumption and "
                "identify reduction opportunities."
            )

    if pd.notna(cost_score):
        if cost_score < 50:
            recommendations.append(
                "Prioritize energy-cost reduction interventions."
            )
        elif cost_score < 75:
            recommendations.append(
                "Review high-cost energy consumption periods."
            )

    if not recommendations:
        recommendations.append(
            "Continue monitoring energy, carbon, and cost performance."
        )

    return recommendations


