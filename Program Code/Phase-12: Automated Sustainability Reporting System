        extracted_value = phase09_extracted_kpis.get(key)
        if extracted_value is None:
            validation_results[key] = "FAIL_MISSING"
            continue

        if key in ["buildings", "daily_records"]:
            passed = int(extracted_value) == int(authoritative_value)
        else:
            passed = numeric_close(extracted_value, authoritative_value)
        validation_results[key] = "PASS" if passed else "FAIL"

