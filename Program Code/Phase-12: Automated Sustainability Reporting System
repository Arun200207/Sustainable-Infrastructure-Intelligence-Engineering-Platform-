def verify_artifacts(artifacts: t.Dict[str, Path]) -> None:
    """Validate that all source artifacts exist on disk."""
    missing = []
    for name, path in artifacts.items():
        if not path.exists():
            missing.append(name)
            logger.error(f"MISSING | {name}: {path}")
        else:
            size_desc = f"{path.stat().st_size / (1024 ** 2):.2f} MB" if path.is_file() else "DIRECTORY"
            logger.info(f"PASS | {name} ({size_desc})")

    if missing:
        raise FileNotFoundError(f"Missing required source artifacts: {missing}")
    logger.info("All expected source artifacts found successfully.")


def find_value(obj: t.Any, candidate_keys: t.List[str]) -> t.Any:
    """Recursively search dictionaries for one of the candidate keys."""
    if isinstance(obj, dict):
        for key in candidate_keys:
            if key in obj:
                return obj[key]
        for value in obj.values():
            result = find_value(value, candidate_keys)
            if result is not None:
                return result
    elif isinstance(obj, list):
        for item in obj:
            result = find_value(item, candidate_keys)
            if result is not None:
                return result
    return None


def numeric_close(a: float, b: float, rel_tol: float = 1e-9, abs_tol: float = 1e-6) -> bool:
    """Check if two numerical values are close within tolerance."""
    return math.isclose(float(a), float(b), rel_tol=rel_tol, abs_tol=abs_tol)


def generate_grounded_recommendation(row: pd.Series) -> t.List[str]:
    """Generate deterministic, grounded recommendations based on building scores."""
    recommendations = []
    carbon_score = row.get("carbon_score")
    cost_score = row.get("cost_score")

    if pd.notna(carbon_score):
        if carbon_score < 50:
            recommendations.append("Prioritize carbon-reduction interventions.")
        elif carbon_score < 75:
            recommendations.append("Review carbon-intensive energy consumption and identify reduction opportunities.")

    if pd.notna(cost_score):
        if cost_score < 50:
            recommendations.append("Prioritize energy-cost reduction interventions.")
        elif cost_score < 75:
            recommendations.append("Review high-cost energy consumption periods.")

    if not recommendations:
        recommendations.append("Continue monitoring energy, carbon, and cost performance.")

    return recommendations


