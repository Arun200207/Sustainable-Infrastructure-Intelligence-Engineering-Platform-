    kb = json.load(f)

records = kb if isinstance(kb, list) else kb.get("records", [])

print("Phase-10 knowledge records:", len(records))

# ------------------------------------------------------------
# Inspect recommendation/intervention fields structurally
# ------------------------------------------------------------

recommendation_records = []

for record in records:
    content = record.get("content", {})

    if not isinstance(content, dict):
        continue

    matching_keys = [
        key for key in content.keys()
        if any(
            term in key.lower()
            for term in [
                "recommend",
                "intervention",
                "action",
                "priority",
                "improvement"
            ]
        )
    ]

    if matching_keys:
        recommendation_records.append({
            "building_id": content.get("building_id"),
            "title": record.get("metadata", {}).get("title"),
            "matching_keys": matching_keys,
            "values": {
                key: content.get(key)
                for key in matching_keys
            }
        })

print(
    "Records containing recommendation/intervention/action fields:",
    len(recommendation_records)
)

for item in recommendation_records[:10]:
    print("\n", item)

