# ============================================================
# PHASE-14 — CELL-5
# INFERENCE FUNCTION
# ============================================================

import numpy as np

def run_inference(
    model,
    features: pd.DataFrame
):

    missing = [
        col
        for col in EXPECTED_FEATURES
        if col not in features.columns
    ]

    if missing:
        raise ValueError(
            f"Missing features: {missing}"
        )

    X_input = features[
        EXPECTED_FEATURES
    ].copy()

    predictions = model.predict(
        X_input
    )

    predictions = np.asarray(
        predictions,
        dtype=float
    )

    if not np.isfinite(
        predictions
    ).all():

        raise ValueError(
            "Non-finite predictions detected."
        )

    return predictions


predictions = run_inference(
    model,
    X
)

print("=" * 60)
print("INFERENCE TEST")
print("=" * 60)

print(
    "Predictions:",
    len(predictions)
)

print(
