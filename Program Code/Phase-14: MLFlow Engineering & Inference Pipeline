print(f"MAE : {mae:.6f}")
print(f"RMSE: {rmse:.6f}")
print(f"R²  : {r2:.6f}")

assert abs(
    mae - EXPECTED_MAE
) < 1e-3

assert abs(
    rmse - EXPECTED_RMSE
) < 1e-3

assert abs(
    r2 - EXPECTED_R2
) < 1e-3

print("\n🟢 PHASE-14 CELL-6: PASS")
