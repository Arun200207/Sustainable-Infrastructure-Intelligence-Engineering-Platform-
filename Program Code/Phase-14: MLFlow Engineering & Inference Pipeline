# ============================================================
# PHASE-14 — SUSTAINABLE INFRASTRUCTURE FORECASTING
# MODEL INFERENCE, MLFLOW TRACKING, & VALIDATION PIPELINE
# ============================================================

import json
import logging
import pickle
import sys
import subprocess
from pathlib import Path

import numpy as np
import pandas as pd
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# ------------------------------------------------------------
# 1. CONFIGURATION & LOGGING SETUP
# ------------------------------------------------------------

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s"
)
logger = logging.getLogger("Phase14Pipeline")

PROJECT_ROOT = Path("/content/drive/MyDrive/GitHub_Project_01")
if not PROJECT_ROOT.exists():
    PROJECT_ROOT = Path.cwd()

MODEL_PATH = PROJECT_ROOT / "models" / "forecasting" / "xgboost_forecast_model.pkl"
TEST_PATH = PROJECT_ROOT / "processed" / "forecasting" / "forecasting_test.parquet"
XAI_PATH = PROJECT_ROOT / "processed" / "phase11_xai" / "xai_test_feature_dataset.parquet"

INFERENCE_DIR = PROJECT_ROOT / "processed" / "phase14_inference"
INFERENCE_PATH = INFERENCE_DIR / "phase14_inference_predictions.parquet"

REPORT_DIR = PROJECT_ROOT / "reports" / "phase14_mlflow"
VALIDATION_PATH = REPORT_DIR / "phase14_final_validation.json"

MLFLOW_DB = PROJECT_ROOT / "mlflow.db"

EXPECTED_FEATURES = [
    "year",
    "month",
    "day",
    "weekday",
    "week_of_year",
    "is_weekend",
    "lag_1",
    "lag_7",
    "lag_14",
    "lag_30",
    "rolling_7",
    "rolling_30",
    "rolling_std_30",
]

EXPECTED_MAE = 6087.625294
EXPECTED_RMSE = 8492.059022
EXPECTED_R2 = 0.768148


# ------------------------------------------------------------
# 2. HELPER FUNCTIONS
# ------------------------------------------------------------

def ensure_mlflow_installed() -> None:
    """Ensures MLflow is available in the environment."""
    try:
        import mlflow
        return mlflow
    except ImportError:
        logger.info("MLflow not found. Installing via pip...")
        subprocess.check_call([
            sys.executable, "-m", "pip", "install", "-q", "mlflow"
        ])
        import mlflow
        return mlflow


def validate_feature_contract(model) -> None:
    """Verifies that the serialized model matches the expected feature contract."""
    model_features = list(getattr(model, "feature_names_in_", []))
    if model_features:
        if model_features != EXPECTED_FEATURES:
            raise ValueError(
                f"Model features {model_features} do not match expected features {EXPECTED_FEATURES}"
            )
        logger.info("Model feature contract validated successfully.")
    else:
        logger.warning("Model does not expose feature_names_in_ attribute.")


def run_inference(model, features: pd.DataFrame) -> np.ndarray:
    """Executes robust inference with structure checks and sanity validation."""
    missing = [col for col in EXPECTED_FEATURES if col not in features.columns]
    if missing:
        raise ValueError(f"Missing required features in dataset: {missing}")

    X_input = features[EXPECTED_FEATURES].copy()
    predictions = model.predict(X_input)
    predictions = np.asarray(predictions, dtype=float)

    if not np.isfinite(predictions).all():
        raise ValueError("Non-finite predictions detected during inference.")

    return predictions


# ------------------------------------------------------------
# 3. MAIN PIPELINE EXECUTION
# ------------------------------------------------------------

def main() -> None:
    logger.info("=" * 60)
    logger.info("PHASE-14 — PROJECT VERIFICATION & EXECUTION")
    logger.info("=" * 60)

    # Step 1: Verify Artifacts
    logger.info(f"Project root: {PROJECT_ROOT}")
    assert PROJECT_ROOT.exists(), f"Project root missing: {PROJECT_ROOT}"
    assert MODEL_PATH.exists(), f"XGBoost model missing: {MODEL_PATH}"
    assert TEST_PATH.exists(), f"Forecasting test data missing: {TEST_PATH}"
    assert XAI_PATH.exists(), f"Phase-11 XAI dataset missing: {XAI_PATH}"
    logger.info("Artifact verification: PASS")

    # Step 2: Environment Check (MLflow)
    mlflow = ensure_mlflow_installed()
    logger.info(f"MLflow version: {mlflow.__version__}")

    # Step 3: Load Model & Feature Contract
    with open(MODEL_PATH, "rb") as f:
        model = pickle.load(f)
    
    validate_feature_contract(model)
    logger.info(f"Model Type: {type(model).__name__}")
    logger.info(f"Required Feature Count: {len(EXPECTED_FEATURES)}")

    # Step 4: Load Inference Dataset
    xai_df = pd.read_parquet(XAI_PATH)
    X = xai_df[EXPECTED_FEATURES].copy()
    y = xai_df["actual_target_energy"].copy()

    logger.info(f"Inference Dataset Rows: {len(X)} | Features: {X.shape[1]}")
    assert len(X) == 110
    assert list(X.columns) == EXPECTED_FEATURES
    assert len(y) == len(X)

    # Step 5: Execute Inference
    predictions = run_inference(model, X)
    logger.info(f"Inference Test Passed. Generated {len(predictions)} predictions.")

    # Step 6: Compute Metrics
    mae = mean_absolute_error(y, predictions)
    rmse = mean_squared_error(y, predictions) ** 0.5
    r2 = r2_score(y, predictions)

    logger.info(f"MAE : {mae:.6f}")
    logger.info(f"RMSE: {rmse:.6f}")
    logger.info(f"R²  : {r2:.6f}")

    assert abs(mae - EXPECTED_MAE) < 1e-3
    assert abs(rmse - EXPECTED_RMSE) < 1e-3
    assert abs(r2 - EXPECTED_R2) < 1e-3

    # Step 7: MLflow Tracking (SQLite Backend)
    tracking_uri = f"sqlite:///{MLFLOW_DB}"
    mlflow.set_tracking_uri(tracking_uri)
    mlflow.set_experiment("sustainable-infrastructure-forecasting")

    with mlflow.start_run(run_name="phase14_xgboost_inference") as run:
        mlflow.log_param("model_type", type(model).__name__)
        mlflow.log_param("feature_count", len(EXPECTED_FEATURES))
        mlflow.log_param("inference_rows", len(X))
        mlflow.log_param("feature_order", ",".join(EXPECTED_FEATURES))

        mlflow.log_metric("mae", float(mae))
        mlflow.log_metric("rmse", float(rmse))
        mlflow.log_metric("r2", float(r2))

        run_id = run.info.run_id

    logger.info(f"MLflow Run successfully logged. Run ID: {run_id}")

    # Step 8: Save Inference Artifact
    INFERENCE_DIR.mkdir(parents=True, exist_ok=True)
    inference_output = xai_df[["datetime", "actual_target_energy"]].copy()
    inference_output["prediction"] = predictions
    inference_output.to_parquet(INFERENCE_PATH, index=False)
    
    assert INFERENCE_PATH.exists()
    assert len(inference_output) == 110
    logger.info(f"Inference artifact saved to: {INFERENCE_PATH}")

    # Step 9: Validation Report Generation
    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    validation_payload = {
        "phase": "Phase-14",
        "status": "PASS",
        "model": {
            "type": type(model).__name__,
            "path": str(MODEL_PATH)
        },
        "feature_contract": {
            "count": len(EXPECTED_FEATURES),
            "features": EXPECTED_FEATURES
        },
        "inference": {
            "rows": len(predictions),
            "finite_predictions": bool(np.isfinite(predictions).all())
        },
        "metrics": {
            "mae": float(mae),
            "rmse": float(rmse),
            "r2": float(r2)
        },
        "mlflow": {
            "tracking_uri": tracking_uri,
            "database": str(MLFLOW_DB),
            "database_exists": MLFLOW_DB.exists(),
            "experiment": "sustainable-infrastructure-forecasting",
            "run_id": run_id
        },
        "artifact": {
            "path": str(INFERENCE_PATH),
            "rows": len(inference_output)
        }
    }

    with open(VALIDATION_PATH, "w") as f:
        json.dump(validation_payload, f, indent=2)

    assert VALIDATION_PATH.exists()
    assert MLFLOW_DB.exists()
    logger.info(f"Validation report saved to: {VALIDATION_PATH}")

    # Step 10: Final Completion Gate
    logger.info("=" * 60)
    logger.info("🟢 PHASE-14 COMPLETE — PASS")
    logger.info("✓ Model loading & validation")
    logger.info("✓ Feature contract verification")
    logger.info("✓ Lightweight inference")
    logger.info("✓ MAE / RMSE / R² threshold gates")
    logger.info("✓ MLflow SQLite tracking & logging")
    logger.info("✓ Inference parquet artifact creation")
    logger.info("✓ Machine-readable JSON validation report")
    logger.info("=" * 60)


if __name__ == "__main__":
    main()
