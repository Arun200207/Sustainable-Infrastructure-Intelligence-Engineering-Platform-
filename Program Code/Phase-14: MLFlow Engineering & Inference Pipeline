# ============================================================
# PHASE-14 — CELL-6
# INFERENCE METRICS
# ============================================================

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

mae = mean_absolute_error(
    y,
    predictions
)

rmse = mean_squared_error(
    y,
    predictions
) ** 0.5

r2 = r2_score(
    y,
    predictions
)

