weather = pd.read_csv(
    os.path.join(DATA_PATH, "weather.csv")
)

weather["timestamp"] = pd.to_datetime(weather["timestamp"])

weather["date"] = weather["timestamp"].dt.floor("D")

weather_daily = (

    weather

    .groupby(
        ["date", "site_id"],
        as_index=False
    )

    .agg({

        "airTemperature":"mean",

        "cloudCoverage":"mean",

        "dewTemperature":"mean",

        "precipDepth1HR":"sum",

        "precipDepth6HR":"sum",

        "seaLvlPressure":"mean",

        "windDirection":"mean",

        "windSpeed":"mean"

    })

)

weather_daily.head()

feature_store = feature_store.merge(

    weather_daily,

    on=[
