utilities = [
    "chilledwater",
    "hotwater",
    "gas",
    "steam",
    "water",
    "irrigation",
    "solar"
]

utility_daily = {}

for resource in utilities:

    print("=" * 60)
    print("Processing:", resource)

    path = os.path.join(PROCESSED_PATH, f"{resource}.parquet")

    df = pd.read_parquet(path)

    # Ensure timestamp is datetime
    df["timestamp"] = pd.to_datetime(df["timestamp"])

    # Create daily date
    df["date"] = df["timestamp"].dt.floor("D")

    # Aggregate to daily consumption
    daily = (
        df
        .groupby(["date", "building_id"], as_index=False)[resource]
        .mean()
    )

    utility_daily[resource] = daily

    print("Original :", df.shape)
    print("Daily    :", daily.shape)

print("\nFinished.")

