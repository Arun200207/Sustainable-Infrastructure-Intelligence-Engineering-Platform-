        "site_id"
    ],

    how="left"

)

print(feature_store.shape)

feature_store["temperature_diff"] = (
    feature_store["airTemperature"] -
    feature_store["dewTemperature"]
)

feature_store["is_rain"] = (
    feature_store["precipDepth1HR"] > 0
).astype(int)

feature_store["high_wind"] = (
    feature_store["windSpeed"] > 15
).astype(int)

feature_store["heating_degree_days"] = (
    18 - feature_store["airTemperature"]
).clip(lower=0)

feature_store["cooling_degree_days"] = (
    feature_store["airTemperature"] - 18
).clip(lower=0)

