import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# Plotting & Display Configuration
sns.set_style("whitegrid")
plt.rcParams["figure.figsize"] = (12, 6)
pd.set_option("display.max_columns", None)
pd.set_option("display.max_rows", 100)

print("Libraries Imported Successfully")

# ============================================================
# 1. LOAD FEATURE STORE & VALIDATE HEALTH
# ============================================================

# Ensure PROCESSED_PATH or PROJECT_PATH is defined in your execution environment
# PROCESSED_PATH = "path/to/processed"
FEATURE_STORE = os.path.join(PROCESSED_PATH, "feature_store", "sustainable_feature_store.parquet")

assert os.path.exists(FEATURE_STORE), f"Feature store not found:\n{FEATURE_STORE}"

df = pd.read_parquet(FEATURE_STORE)
print("✅ Feature Store Loaded Successfully")
print(f"Shape : {df.shape}")

memory = df.memory_usage(deep=True).sum() / 1024**2
print("=" * 50)
print(f"MEMORY USAGE: {memory:.2f} MB")
print("=" * 50)

# Dataset Summary & Health Report
numeric_cols = df.select_dtypes(include="number").columns.tolist()
categorical_cols = df.select_dtypes(exclude="number").columns.tolist()

print("=" * 70)
print("DATASET HEALTH REPORT")
print("=" * 70)
print(f"Rows                     : {df.shape[0]:,}")
print(f"Columns                  : {df.shape[1]}")
print(f"Memory Usage             : {memory:.2f} MB")
print(f"Numeric Features         : {len(numeric_cols)}")
print(f"Categorical Features     : {len(categorical_cols)}")
print(f"Missing Values           : {df.isnull().sum().sum()}")
print(f"Duplicate Rows           : {df.duplicated().sum()}")
print(f"Buildings                : {df['building_id'].nunique()}")
print(f"Campuses                 : {df['campus'].nunique()}")
print(f"Sites                    : {df['site_id'].nunique()}")
print(f"Date Range Start         : {df['date'].min()}")
print(f"Date Range End           : {df['date'].max()}")
print("=" * 70)

# ============================================================
# 2. ENERGY CONSUMPTION INTELLIGENCE & EDA
# ============================================================

utility_columns = [
    "electricity", "gas", "steam", "water", 
    "solar", "chilledwater", "hotwater", "irrigation"
]
available_utilities = [col for col in utility_columns if col in df.columns]

# Daily Aggregation
eda_daily = (
    df.groupby("date")
    .agg({col: "sum" for col in available_utilities if col in df.columns})
    .reset_index()
)

# Visualizations (Plotly)
fig_daily = px.line(eda_daily, x="date", y="electricity", title="Daily Electricity Consumption Trend", template="plotly_white")
fig_daily.update_layout(height=500)
fig_daily.show()

monthly_energy = df.assign(month=df["date"].dt.month).groupby("month")["electricity"].mean().reset_index()
fig_monthly = px.bar(monthly_energy, x="month", y="electricity", title="Average Monthly Electricity Consumption", template="plotly_white")
fig_monthly.show()

season_energy = df.groupby("season")["electricity"].mean().reset_index()
fig_season = px.bar(season_energy, x="season", y="electricity", color="season", title="Average Electricity Consumption by Season")
fig_season.show()

utility_profile = df[available_utilities].sum().reset_index()
utility_profile.columns = ["utility", "total_consumption"]
fig_pie = px.pie(utility_profile, names="utility", values="total_consumption", title="Infrastructure Utility Consumption Distribution", hole=0.45)
fig_pie.show()

campus_energy = df.groupby("campus")["electricity"].sum().sort_values(ascending=False).reset_index()
campus_energy.columns = ["campus", "electricity_consumption"]
fig_campus = px.bar(campus_energy, x="campus", y="electricity_consumption", color="electricity_consumption", title="Campus-wise Electricity Consumption", template="plotly_white")
fig_campus.show()

building_type_energy = df.groupby("building_type")["electricity"].mean().sort_values(ascending=False).reset_index()
building_type_energy.columns = ["building_type", "average_energy"]
fig_btype = px.bar(building_type_energy, x="building_type", y="average_energy", color="average_energy", title="Average Energy Consumption by Building Type")
fig_btype.update_layout(xaxis_tickangle=-45)
fig_btype.show()

# ============================================================
# 3. WEATHER FEATURE ANALYSIS
# ============================================================

weather_features = [
    "airTemperature", "dewTemperature", "windSpeed", "windDirection",
    "cloudCoverage", "precipDepth1HR", "precipDepth6HR",
    "heating_degree_days", "cooling_degree_days"
]
available_weather = [col for col in weather_features if col in df.columns]

weather_energy_corr = df[available_weather + ["electricity"]].corr()

plt.figure(figsize=(12, 8))
sns.heatmap(weather_energy_corr, annot=True, cmap="coolwarm", center=0)
plt.title("Weather Features vs Electricity Correlation")
plt.show()

# Temperature Impact Plots
temp_energy = df.groupby("airTemperature")["electricity"].mean().reset_index()
fig_temp = px.scatter(temp_energy, x="airTemperature", y="electricity", trendline="lowess", title="Temperature Impact on Electricity Consumption", template="plotly_white")
fig_temp.show()

cdd_energy = df.groupby("cooling_degree_days")["electricity"].mean().reset_index()
fig_cdd = px.scatter(cdd_energy, x="cooling_degree_days", y="electricity", title="Cooling Degree Days vs Electricity Consumption", template="plotly_white")
fig_cdd.show()

hdd_energy = df.groupby("heating_degree_days")["electricity"].mean().reset_index()
fig_hdd = px.scatter(hdd_energy, x="heating_degree_days", y="electricity", title="Heating Degree Days vs Electricity Consumption", template="plotly_white")
fig_hdd.show()

# ============================================================
# 4. BUILDING PERFORMANCE & SUSTAINABILITY SCORING
# ============================================================

building_performance = (
    df.groupby(
        ["building_id", "building_name", "building_type", "campus", "sqm", "occupants"]
    )
    .agg(
        total_electricity=("electricity", "sum"),
        average_temperature=("airTemperature", "mean"),
        total_solar=("solar", "sum") if "solar" in df.columns else ("electricity", "sum"),
        total_water=("water", "sum") if "water" in df.columns else ("electricity", "sum")
    )
    .reset_index()
)

building_performance["energy_intensity"] = (
    building_performance["total_electricity"] / building_performance["sqm"]
)

min_intensity = building_performance["energy_intensity"].min()
max_intensity = building_performance["energy_intensity"].max()

building_performance["sustainability_score"] = (
    100 - ((building_performance["energy_intensity"] - min_intensity) / (max_intensity - min_intensity)) * 100
)

sustainability_ranking = building_performance.sort_values("sustainability_score", ascending=False)

campus_sustainability = (
    building_performance.groupby("campus")
    .agg(
        total_energy=("total_electricity", "sum"),
        avg_energy_intensity=("energy_intensity", "mean"),
        avg_sustainability_score=("sustainability_score", "mean")
    )
    .reset_index()
    .sort_values("avg_sustainability_score", ascending=False)
)

fig_cs = px.bar(
    campus_sustainability,
    x="campus",
    y="avg_sustainability_score",
    color="avg_sustainability_score",
    title="Campus Sustainability Ranking",
    template="plotly_white"
)
fig_cs.show()

# ============================================================
# 5. EXPORT EDA OUTPUTS
# ============================================================

OUTPUT_PATH = os.path.join(PROCESSED_PATH, "eda_outputs")
os.makedirs(OUTPUT_PATH, exist_ok=True)

building_performance.to_parquet(os.path.join(OUTPUT_PATH, "building_performance.parquet"))
campus_sustainability.to_parquet(os.path.join(OUTPUT_PATH, "campus_sustainability.parquet"))
sustainability_ranking.to_parquet(os.path.join(OUTPUT_PATH, "sustainability_ranking.parquet"))

print("✅ EDA outputs exported successfully to:", OUTPUT_PATH)
