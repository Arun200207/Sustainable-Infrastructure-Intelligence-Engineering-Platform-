# BUILDING PERFORMANCE INTELLIGENCE TABLE
# ============================================================

building_performance = (
    df
    .groupby(
        [
            "building_id",
            "building_name",
            "building_type",
            "campus",
            "sqm",
            "occupants"
        ]
    )
    .agg(
        total_electricity=("electricity","sum"),
        average_temperature=("airTemperature","mean"),
        total_solar=("solar","sum"),
        total_water=("water","sum")
    )
    .reset_index()
)


building_performance.head()

building_performance["energy_intensity"] = (
    building_performance["total_electricity"]
    /
    building_performance["sqm"]
)


building_performance.head()

# Normalize energy intensity

min_intensity = (
    building_performance["energy_intensity"].min()
)

max_intensity = (
    building_performance["energy_intensity"].max()
)


building_performance["sustainability_score"] = (
    100 -
    (
        (
            building_performance["energy_intensity"]
            -
            min_intensity
        )
        /
        (
            max_intensity -
            min_intensity
        )
    )
    *
    100
)


sustainability_ranking = (
    building_performance
    .sort_values(
        "sustainability_score",
        ascending=False
    )
)


sustainability_ranking.head(10)

